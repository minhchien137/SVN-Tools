    async function CheckSerialNumberInDB(oneSerial, reportSerial) {
        var newItem = $(oneSerial).val();
        if (newItem.length == 14) {
            try {
                const response = await $.ajax({
                    url: '@Url.Action("GetRecordBySerialID", "Home")',
                    type: 'POST',
                    data: { newItem: newItem },
                    dataType: 'json'
                });
                if (response.ok == true) {
                    return true;
                } else {
                    $(reportSerial).text(newItem + response.message);
                    $(oneSerial).val('');
                    $(oneSerial).focus();
                    return false;
                }
            } catch (error) {
                console.error("AJAX error:", error);
                alert("An error occurred while printing.");
                return false;
            }
        }
        return false;
    }


