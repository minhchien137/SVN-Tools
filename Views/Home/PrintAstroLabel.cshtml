    async function GetSerialNumber(oneSerialSelector, allSerialSelector, countSerialSelector, reportSerialSelector) {
        const $oneSerial = $(oneSerialSelector);
        const $allSerial = $(allSerialSelector);
        const $countSerial = $(countSerialSelector);
        const $reportSerial = $(reportSerialSelector);

        const newItem = $oneSerial.val();

        // 1. Validate newItem length first
        // Chú ý: bạn đã thay đổi độ dài từ 13 sang 14.
        if (newItem.length !== 14) {
            $reportSerial.text('Serial number phải có 14 ký tự.'); // Thông báo rõ ràng hơn
            $oneSerial.val('');
            $oneSerial.focus();
            return; // Dừng hàm nếu không hợp lệ
        }

        // 2. Chờ kết quả từ hàm CheckSerialNumberInDB (phải là async)
        // isExitsInDB sẽ nhận giá trị true/false sau khi CheckSerialNumberInDB hoàn thành
        const isExitsInDB = await CheckSerialNumberInDB(oneSerialSelector, reportSerialSelector);

        if (!isExitsInDB) {
            // Hàm CheckSerialNumberInDB (đã refactor) đã xử lý thông báo lỗi và focus input
            // Nếu nó trả về false, nghĩa là serial không tồn tại trong DB hoặc có lỗi
            return; // Dừng hàm nếu không đủ điều kiện DB
        }

        // Nếu newItem.length == 14 VÀ isExitsInDB là true
        let currentSeries = $allSerial.val();
        // Lọc bỏ phần tử rỗng ngay lập tức và chỉ một lần
        let arr = currentSeries.split(',').filter(el => el !== '');

        // Logic xử lý khi serial hợp lệ và tồn tại trong DB
        if (currentSeries === '') {
            $allSerial.val(newItem + ',');
            $countSerial.val('1');
            $reportSerial.text(''); // Xóa thông báo nếu có
        } else {
            // Kiểm tra xem serial mới đã tồn tại trong danh sách cục bộ chưa
            const isExitsLocally = arr.includes(newItem); // Dùng includes() cho dễ

            if (isExitsLocally) {
                $reportSerial.text(newItem + ' đã tồn tại trong danh sách.');
            } else {
                // Xác định giới hạn serial
                const limitSeri = $('#chkbApplyPrint150').is(':checked') ? 50 : 12;

                if (arr.length >= limitSeri) {
                    $reportSerial.text('Đã đủ số lượng serial number (' + limitSeri + ').');
                } else { // Serial không tồn tại cục bộ và chưa đạt giới hạn
                    $allSerial.val(currentSeries + newItem + ',');
                    $reportSerial.text(''); // Xóa thông báo lỗi cũ
                }
            }
        }

        // Cập nhật lại số lượng serial (sau khi có thể đã thêm mới)
        const updatedSeries = $allSerial.val();
        const updatedArr = updatedSeries.split(',').filter(el => el !== '');
        $countSerial.val(String(updatedArr.length));

        // Reset input và focus cuối cùng
        $oneSerial.val('');
        $oneSerial.focus();
    }

    function ClearSerial(allSerial, countSerial, reportSerial){
        $(allSerial).val('');
        $(countSerial).val('');
        $(reportSerial).text('');
        $("#txtNewSeri1").forcus();
    }

    function DeleteSerialHistory(allSerial){
        var serialList = $(allSerial).val();
        $.ajax({
            url: '@Url.Action("DeleteAstroSerialHistory", "Home")',  // Adjust the controller name if needed
            type: 'POST',
            data: {serialList: serialList, operation: "Astro"},
            dataType: 'json',
            success: function (response) {
                alert(response.message);

            },
            error: function (xhr, status, error) {
                console.error("AJAX error:", error);
                alert("An error occurred while printing.");
            }
        });
    }

    function UpdatePackageID(txtPackageID) {
        var packageID = $(txtPackageID).val();
        $.ajax({
            url: '@Url.Action("UpdatePackageID", "Home")',  // Adjust the controller name if needed
            type: 'POST',
            data: {packageID: packageID},
            dataType: 'json',
            success: function (response) {
                if(response.result == false) {
                    alert(response.message);
                }
                else{
                    $(txtPackageID).val(response.packageID);
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX error:", error);
                alert("An error occurred while getting Pallet ID.");
            }
        });
    }

    function ChangeForcusTextBox(curtextbox, nexttextbox){

        $(curtextbox).keypress(function(event) {
            if (event.which === 13) { // phím Enter có mã là 13
            $(nexttextbox).focus();
            }
        });
    }
</script>
