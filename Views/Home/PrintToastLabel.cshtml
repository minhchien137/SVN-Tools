<script>
    // $(document).ready(function () {
    //     $('#selectedProductID').select2({
    //         placeholder: "Select an option",
    //         allowClear: true
    //     });
    // });

    $(document).ready(function() {

        $('#selectedPrinterID').selectpicker();

        $('#txtToastPartNumber').focus();

        $("#printButton").click(function () {
            var partNumber = $("#txtToastPartNumber").val();
            var modelNumber = $("#txtModelNumber").val();
            var toastPONumber = $("#txtToastPONumber").val();
            var quantity = $("#txtQuantity").val();
            var lotID = $("#txtLotID").val();
            var partDesc = $("#txtPartDesc").val();
            var print150Seri = $('#chkbApplyPrint150').is(':checked');
            var allSeri1 = $("#txtSeriNumber1").val();
            var allSeri2 = $("#txtSeriNumber2").val();
            var allSeri3 = $("#txtSeriNumber3").val();
            var copies = parseInt($("#copiesInput").val(), 10);
            var palletIDVal = $("#txtPalletID").val();

            var selectPrinterID = document.getElementById("selectedPrinterID").value;

            // Wrap the values in a single object that matches the PrintRequest class
            var requestPayload = {
                PartNumber: partNumber, // case-sensitive; property name must match
                ModelNumber: modelNumber,
                ToastPONumber: toastPONumber,
                Quantity: quantity,
                LotID: lotID,
                PartDesc: partDesc,
                Print150Seri: print150Seri,
                AllSeri1: allSeri1,
                AllSeri2: allSeri2,
                AllSeri3: allSeri3,
                Copies: copies,
                PrinterID: selectPrinterID,
                PalletID: palletIDVal
            };

            $.ajax({
                url: '@Url.Action("PrintToastLabelAJAX", "Home")',  // Adjust the controller name if needed
                type: 'POST',
                data: JSON.stringify(requestPayload),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                success: function (response) {
                    $("#txtPalletID").val(response.palletID);
                    if(response.result == false) {
                        alert(response.message);
                    } 
                    else{
                        $("#txtNewSeri1").focus();
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", error);
                    alert("An error occurred while printing.");
                }
            });
        });

        $('#chkbApplyPrint150').on('change', function() {
          if ($(this).is(':checked')) {
            // Checkbox được chọn, thực hiện hành động
            $('#divSeriNumber2').removeClass('d-none');
            $('#divSeriNumber3').removeClass('d-none');
          } else {
            // Checkbox không được chọn, không làm gì
            $('#divSeriNumber2').addClass('d-none');
            $('#divSeriNumber3').addClass('d-none');
          }
        });

        $("#printConfirmPallet").click(function () {
            var partNumber = $("#txtToastPartNumber").val();
            var modelNumber = $("#txtModelNumber").val();
            var toastPONumber = $("#txtToastPONumber").val();
            var quantity = $("#txtQuantity").val();
            var lotID = $("#txtLotID").val();
            var partDesc = $("#txtPartDesc").val();
            var print150Seri = $('#chkbApplyPrint150').is(':checked');
            var allSeri1 = $("#txtSeriNumber1").val();
            var allSeri2 = $("#txtSeriNumber2").val();
            var allSeri3 = $("#txtSeriNumber3").val();
            var copies = parseInt($("#copiesInput").val(), 10);
            var palletIDVal = $("#txtPalletID").val();

            var selectPrinterID = document.getElementById("selectedPrinterID").value;

            // Wrap the values in a single object that matches the PrintRequest class
            var requestPayload = {
                PartNumber: partNumber, // case-sensitive; property name must match
                ModelNumber: modelNumber,
                ToastPONumber: toastPONumber,
                Quantity: quantity,
                LotID: lotID,
                PartDesc: partDesc,
                Print150Seri: print150Seri,
                AllSeri1: allSeri1,
                AllSeri2: allSeri2,
                AllSeri3: allSeri3,
                Copies: copies,
                PrinterID: selectPrinterID,
                PalletID: palletIDVal
            };

            $.ajax({
                url: '@Url.Action("PrintPalletLabelAJAX", "Home")',  // Adjust the controller name if needed
                type: 'POST',
                data: JSON.stringify(requestPayload),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                success: function (response) {
                    if(response.result == false) {
                        alert(response.message);
                    }
                    else{
                        $('#printStartNewPallet').removeClass('d-none');
                        $("#txtNewSeri1").focus();
                    }

                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", error);
                    alert("An error occurred while printing.");
                }
            });
        });

        $("#printStartNewPallet").click(function () {
            $("#txtPalletID").val('');
            $('#printStartNewPallet').addClass('d-none');
            $("#txtNewSeri1").focus();
        });
    });
</script>