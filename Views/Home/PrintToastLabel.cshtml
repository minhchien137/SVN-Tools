        async function GetSerialNumber(oneSerialSelector, allSerialSelector, countSerialSelector, reportSerialSelector) {
            const $oneSerial = $(oneSerialSelector);
            const $allSerial = $(allSerialSelector);
            const $countSerial = $(countSerialSelector);
            const $reportSerial = $(reportSerialSelector);

            const newItem = $oneSerial.val();

            // 1. Validate newItem length first
            if (newItem.length !== 13) {
                // Tùy chọn: hiển thị thông báo lỗi nếu serial không đúng độ dài
                // $reportSerial.text('Serial number phải có 13 ký tự.');
                $oneSerial.val('');
                $oneSerial.focus();
                return; // Dừng hàm nếu không hợp lệ
            }

            // 2. Check in DB (assuming CheckSerialNumberInDB is already async and correct)
            const isExitsInDB = await CheckSerialNumberInDB(oneSerialSelector, reportSerialSelector);

            if (!isExitsInDB) {
                // CheckSerialNumberInDB đã xử lý thông báo lỗi và focus input nếu cần
                return; // Dừng hàm nếu không tồn tại trong DB hoặc có lỗi DB
            }

            // Nếu newItem.length == 13 VÀ isExitsInDB là true
            let currentSeries = $allSerial.val();
            let arr = currentSeries.split(',').filter(el => el !== ''); // Lọc bỏ phần tử rỗng ngay lập tức

            // 3. Logic xử lý khi serial hợp lệ và tồn tại trong DB
            if (currentSeries === '') {
                $allSerial.val(newItem + ',');
                $countSerial.val('1');
            } else {
                const newPrefix = newItem.slice(0, -4);
                const newNumber = newItem.slice(-4);

                let isExitsLocally = false;
                let isMatchedPrefix = false;

                for (const existingSerial of arr) {
                    const existingPrefix = existingSerial.slice(0, -4);
                    const existingNumber = existingSerial.slice(-4);

                    if (newPrefix === existingPrefix) {
                        isMatchedPrefix = true;
                        if (newNumber === existingNumber) {
                            isExitsLocally = true;
                            $reportSerial.text(newItem + ' đã tồn tại trong danh sách.');
                            break; // Thoát vòng lặp ngay khi tìm thấy
                        }
                    }
                }

                const limitSeri = $('#chkbApplyPrint150').is(':checked') ? 50 : 5;

                if (isExitsLocally) {
                    // Đã được xử lý trong vòng lặp for (hiển thị thông báo)
                } else if (!isMatchedPrefix) {
                    // Nếu không khớp prefix với bất kỳ serial nào trong danh sách
                    $reportSerial.text('Serial ' + newItem + ' có prefix không khớp với các serial đã nhập.');
                } else if (arr.length >= limitSeri) {
                    $reportSerial.text('Đã đủ số lượng serial number (' + limitSeri + ').');
                } else { // isExitsLocally == false && isMatchedPrefix == true && arr.length < limitSeri
                    $allSerial.val(currentSeries + newItem + ',');
                    $reportSerial.text(''); // Xóa thông báo lỗi cũ
                }
            }

            // Cập nhật lại số lượng serial (sau khi có thể đã thêm mới)
            const updatedSeries = $allSerial.val();
            const updatedArr = updatedSeries.split(',').filter(el => el !== '');
            $countSerial.val(String(updatedArr.length));

            // Reset input và focus
            $oneSerial.val('');
            $oneSerial.focus();
    }

    function ClearSerial(allSerial, countSerial, reportSerial){
        $(allSerial).val('');
        $(countSerial).val('');
        $(reportSerial).text('');
        $("#txtNewSeri1").focus();
    }

    function DeleteSerialHistory(allSerial){
        var serialList = $(allSerial).val();
        var serachSerialID = $("#txtSearchSerialID").val();
        $.ajax({
            url: '@Url.Action("DeleteSerialHistory", "Home")',  // Adjust the controller name if needed
            type: 'POST',
            data: {serialList: serialList, operation: "TOAST", serachSerialID: serachSerialID},
            dataType: 'json',
            success: function (response) {
                alert(response.message);

            },
            error: function (xhr, status, error) {
                console.error("AJAX error:", error);
                alert("An error occurred while printing.");
            }
        });
    }

    function GetCountBoxInPallet(){
        var PalletID = $("#txtPalletID").val();
        $.ajax({
            url: '@Url.Action("GetCountBoxInPallet", "Home")',  // Adjust the controller name if needed
            type: 'POST',
            data: {PalletID: PalletID},
            dataType: 'json',
            success: function (response) {
                if(response.result){
                    $("#strBoxCount").text(response.boxCount)
                }
                else{
                    alert(response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX error:", error);
                alert("An error occurred while printing.");
            }
        });
    }

    function ChangeForcusTextBox(curtextbox, nexttextbox){
        
        $(curtextbox).keypress(function(event) {
            if (event.which === 13) { // phím Enter có mã là 13
            $(nexttextbox).focus();
            }
        });
    }
