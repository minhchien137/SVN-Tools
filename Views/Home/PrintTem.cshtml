@model List<PrintTemViewModel>
@using Newtonsoft.Json;
@{
    Layout = "~/Views/Shared/_ToolsLayout.cshtml";
    ViewData["Title"] = "In tem";
}
@* <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script> *@

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.18/dist/css/bootstrap-select.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.18/dist/js/bootstrap-select.min.js"></script>

<form method="post">
    <div class="row">
        <div class="row col-12">
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Chọn số dòng cần lấy</label>
                    <input type="number" name="countRows" class="form-control" value="@ViewBag.CountRows" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Chọn sản phẩm</label>
                    <select id="selectedProductID" class="form-control" name="selectedProductID" data-live-search="true" asp-items="@ViewBag.ProductList"></select>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group" style="margin-top:33px">
                    <button class="btn btn-success" type="submit"><i class="fa fa-filter"></i> Tìm kiếm</button>
                </div>
            </div>
        </div>
        @if (Model != null && Model.Count() > 0)
        {
            <div class="row col-12">
                <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Chọn máy in</label>
                    <select id="selectedPrinterID" class="form-control" name="selectedPrinterID" data-live-search="true" asp-items="@ViewBag.PrinterList">
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Số lượng bản</label>
                    <input type="number" id="copiesInput" name="copies" class="form-control" value="1" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group" style="margin-top:33px">
                    <button type="button" class="btn btn-primary" id="printButton"><i class="fa fa-print"></i> In</button>
                </div>
            </div>
        </div>
        }
        <div class="col-12">
            <table class="table">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">No</th>
                        <th scope="col">Tên sản phẩm</th>
                        <th scope="col">Mã Lot</th>
                        <th scope="col">Số lượng đã sản xuất</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count() > 0)
                    {
                        for (int i = 0; i < Model.Count(); i++)
                        {
                            <tr>
                                @{
                                    int no = i + 1;
                                }
                                <th scope="row">@no</th>
                                <td>
                                    @Model[i].item_name
                                    <input type="hidden" asp-for="@Model[i].item_name" />
                                </td>
                                <td>
                                    @Model[i].lot_code
                                    <input type="hidden" asp-for="@Model[i].lot_code" />
                                </td>
                                <td>
                                    @Model[i].product_qty
                                    <input type="hidden" asp-for="@Model[i].product_qty" />
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">Không có dữ liệu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>
<script>
    // $(document).ready(function () {
    //     $('#selectedProductID').select2({
    //         placeholder: "Select an option",
    //         allowClear: true
    //     });
    // });
    
    $(document).ready(function() {
        
        $('#selectedProductID').selectpicker();

        $('#selectedPrinterID').selectpicker();

        

        $("#printButton").click(function () {
            var printModels = @Html.Raw(JsonConvert.SerializeObject(Model));
            var copies = parseInt($("#copiesInput").val(), 10);

            var selectPrinterID = document.getElementById("selectedPrinterID").value;

            // Wrap the values in a single object that matches the PrintRequest class
            var requestPayload = {
                ViewModels: printModels, // case-sensitive; property name must match
                Copies: copies,
                PrinterID: selectPrinterID
            };

            $.ajax({
                url: '@Url.Action("Print", "Home")',  // Adjust the controller name if needed
                type: 'POST',
                data: JSON.stringify(requestPayload),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                success: function (response) {
                    alert(response.message);
                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", error);
                    alert("An error occurred while printing.");
                }
            });
        });
    });
</script>