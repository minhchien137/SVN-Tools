@{
    Layout = "~/Views/Shared/_ToolsLayout.cshtml";
    ViewData["Title"] = "Cập nhật lênh sản xuất";
}
<form method="post">
    <div class="row">
        <div class="row col-12">
            <div class="col-12 col-md-3">
                <div class="form-group">
                    <label class="control-label">Lệnh sản xuất</label>
                    <input type="text" name="workOrderCode" class="form-control" value="@ViewBag.WorkOrder" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="form-group" style="margin-top:33px">
                    <button class="btn btn-success" type="submit"><i class="fa fa-filter"></i> Update số lượng</button>
                </div>
            </div>
        </div>
    </div>
</form>
