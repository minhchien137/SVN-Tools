@model SVN_Tools.Models.Utils.PrinterData;

@{
    ViewData["Title"] = ViewBag.oper;
}

<style>
    /* Fix cho Select2 CSS */
    .select2-container--default .select2-selection--single {
        height: 42px !important;
        border: 1px solid #ced4da !important;
        border-radius: 0.25rem !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: black !important;
        line-height: 40px !important;
        padding-left: 12px !important;
        padding-right: 20px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 40px !important;
        right: 10px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow b {
        border-color: #555 transparent transparent transparent !important;
        margin-left: -4px !important;
        margin-top: -2px !important;
    }

    .select2-dropdown {
        border: 1px solid #ced4da !important;
        border-radius: 0.25rem !important;
    }

    .select2-container--default .select2-results__option {
        color: black !important;
        padding: 8px 12px !important;
    }

    .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: #007bff !important;
        color: white !important;
    }

    .select2-container--default .select2-search--dropdown .select2-search__field {
        border: 1px solid #ced4da !important;
        border-radius: 0.25rem !important;
        padding: 8px !important;
        color: black !important;
    }

    /* Fix width để match với form-control */
    .select2-container {
        width: 100% !important;
    }
</style>

<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

<h1>@ViewBag.oper</h1>

<div>
    <h4>Printer Details</h4>
    <hr />
    <div class="row">
        <div class="col-6">
            <div class="row">
                <div class="col-2">
                    @Html.DisplayNameFor(model => model.Name_Printer)
                </div>
                <div class="col-10">
                    @Html.DisplayFor(model => model.Name_Printer)
                </div>
                <div class="col-2">
                    @Html.DisplayNameFor(model => model.IP_Printer)
                </div>
                <div class="col-10">
                    @Html.DisplayFor(model => model.IP_Printer)
                </div>
                <div class="col-2">
                    @Html.DisplayNameFor(model => model.Port_Printer)
                </div>
                <div class="col-10">
                    @Html.DisplayFor(model => model.Port_Printer)
                </div>
                <div class="container mt-3">
                    <div class="col-12">
                        <hr />
                        <div class="form-row align-items-center mb-3">
                            <div class="col-auto">
                                <label for="sizeLabel" class="">Size:</label> <input type="text"
                                    class="form-control form-control-sm" id="sizeLabel" placeholder="Size" value="24"
                                    disabled />
                            </div>
                            <div class="col-auto">
                                <label for="widthLabel" class="">Width:</label>
                                <input type="text" class="form-control form-control-sm" id="widthLabel"
                                    placeholder="Width" value="4" disabled />
                            </div>
                            <div class="col-auto">
                                <label for="heightLabel" class="">Height:</label>
                                <input type="text" class="form-control form-control-sm" id="heightLabel"
                                    placeholder="Height" value="6" disabled />
                            </div>
                            <div class="col-auto">
                                <label for="copies" class="">Copies:</label>
                                <input type="number" class="form-control form-control-sm" id="copies"
                                    placeholder="Copies" value="1" required />
                            </div>
                        </div>
                        <hr />
                        <div class="form-group mb-3">
                            <label for="upcNumber" class="">Chọn mã upc</label>
                            <select class="form-control form-control-sm select2" id="upcNumber"
                                style="height:42px; color:black">
                                <option selected disabled>Chọn mã upc</option>
                            </select>
                        </div>
                        @* <div class="form-group mb-3">
                            <p id="upcInfo"></p>
                        </div> *@

                        <div class="form-row align-items-center mb-3">
                            <div class="col-md-4">
                                <label for="poNumber" class="">PO Number:</label>
                                <input type="text" class="form-control form-control-sm" id="poNumber"
                                    placeholder="PO Number" required />
                            </div>
                            <div class="col-md-4">
                                <label for="totalCt" class="">Total C/T NO:</label>
                                <input type="number" class="form-control form-control-sm" id="totalCt"
                                    placeholder="C/T Total" required />
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-primary" type="button" id="savePO"
                                    style="margin-top: 34px; height: 42px">Save</button>
                            </div>
                            @* <div class="col-md-4">
                                <label for="itemSize" class="">Size:</label> *@
                            @* <select class="form-control form-control-sm" id="itemSize">
                                    <option value="">Không có</option>
                                    <option value="S/M">S/M</option>
                                    <option value="L/XL">L/XL</option>
                                </select> *@
                            @* <input type="text" class="form-control form-control-sm mb-2" id="itemSize"
                                    placeholder="Size" disabled />
                            </div> *@
                        </div>

                        <div class="form-row align-items-center mb-3">
                            <div class="col-md-4">
                                <label for="ctNo" class="">C/T NO:</label>
                                <input type="number" class="form-control form-control-sm" id="ctNo" placeholder="C/T NO"
                                    required />
                            </div>
                            <div class="col-md-4">
                                <label for="quantity" class="">Quantity:</label>
                                <input type="number" class="form-control form-control-sm" id="quantity"
                                    placeholder="Quantity" required />
                                @* <select class="form-control form-control-sm" id="quantity" style="height: 42px;">
                                    <option value="36">36</option>
                                    <option value="80">80</option>
                                </select> *@
                            </div>
                            <div class="col-md-4"> <label for="dateWhoop" class="">Date:</label>
                                <input type="date" class="form-control form-control-sm" id="dateWhoop"
                                    placeholder="Date" required />
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row mt-4">
                        <div class="col-12">
                            <button class="btn btn-primary" style="margin-left: 12px" id="preview"
                                type="submit">Preview</button>
                            <button class="btn btn-primary" style="margin-left: 12px" id="print" type="submit">In
                                Tem</button>
                            <button class="btn btn-primary" style="margin-left: 12px" id="quick" type="submit">In
                                nhanh</button>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-md-4">
                            <label for="startCT" class="">Start:</label>
                            <input type="number" class="form-control form-control-sm" id="startCT" placeholder="Start"
                                value="1" required />
                        </div>
                        <div class="col-md-4">
                            <label for="inMotLoat" class="">End:</label>
                            <input type="number" class="form-control form-control-sm" id="inMotLoat" placeholder="End"
                                required />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary" type="button" id="inMotLoatBtn"
                                style="margin-top: 34px; height: 42px">In 1 loạt</button>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-12">
                            <ul>
                                @* <li>Numpad1: Nhập KQSX</li> *@
                                <li>Numpad2: Scan Check</li>
                                @* <li>Numpad3: In Walter</li> *@
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* <div class="col-6">
            <div class="imagebox">
                <img id="labelImage" src="@ViewBag.imageUrl" style="width:80%" alt="Ấn nút Lưu Zpl và nút Load Ảnh" />
            </div>
        </div> *@
    </div>
</div>
<div>
    <hr />
    <hr />
    <a asp-action="UltimatePrint">Back to List</a>
</div>

<script>


    document.addEventListener('DOMContentLoaded', async function () {
        let zplTemplate;
        let previewBtn = document.getElementById('preview');
        let printBtn = document.getElementById('print');
        let quickBtn = document.getElementById('quick');
        let inMotLoatBtn = document.getElementById('inMotLoatBtn');
        @* let upcItem, upcColor, upcPnNumber, upcSize = ""; *@

            window.upcItem = "";
        window.upcColor = "";
        window.upcPnNumber = "";

        window.upcSize = "";

        @* const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, '0');
        const day = String(today.getDate()).padStart(2, '0');
        const formattedDate = `${year}-${month}-${day}`;
        dateWhoopInput.value = formattedDate; *@

        const savePOButton = document.getElementById("savePO");
        savePOButton.addEventListener("click", async () => {
            const poNumber = document.getElementById('poNumber').value;
            const totalCt = document.getElementById('totalCt').value;
            const dateWhoop = document.getElementById('dateWhoop').value;
            const quantity = document.getElementById('quantity').value;

            await localStorage.setItem("poNumber", poNumber);
            await localStorage.setItem("totalCt", totalCt);
            await localStorage.setItem("dateWhoop", dateWhoop);
            await localStorage.setItem("quantity", quantity);
        })

        const loadPreviousData = () => {
            const poNumber = localStorage.getItem("poNumber");
            const totalCt = localStorage.getItem("totalCt");
            const dateWhoop = localStorage.getItem('dateWhoop');
            const quantity = localStorage.getItem('quantity');
            if (poNumber) {
                document.getElementById('poNumber').value = poNumber;
            }
            if (totalCt) {
                document.getElementById('totalCt').value = totalCt;
                document.getElementById('inMotLoat').value = totalCt;
            }
            if (totalCt) {
                document.getElementById('dateWhoop').value = dateWhoop;
            }
            if (quantity) {
                document.getElementById('quantity').value = quantity;
            }
        }

        loadPreviousData();

        const totalCtInput = document.getElementById('totalCt');
        totalCtInput.addEventListener('input', () => {
            const inMotLoatInput = document.getElementById('inMotLoat');
            inMotLoatInput.value = totalCtInput.value;
        })

        const fetchImage = async (size, width, height, desc, quantity, upcNumber, poNumber, ctNumber, itemSize, dateWhoop, upcPnNumber, upcColor, upcItem) => {
            const url = '@Url.Action("CreateLabelNoPreview", "Utils")';

            @* const image = $("#labelImage")[0]; *@

            const _ = window.location.pathname.split("/");
            const id = _[_.length - 1];


            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ size, width, height, id, desc, quantity, upcNumber, poNumber, ctNumber, itemSize, dateWhoop, upcPnNumber, upcColor, upcItem })
            });

            if (res.ok) {
                const result = await res.json();
                @* image.setAttribute("src", result.imagePath); *@
                    zplTemplate = result.template;
                console.log(result)
                return zplTemplate;
            }
        }

        const getCTfromUpc = async (upc_number) => {
            upc_number = upc_number.toString();
            const url = '@Url.Action("CheckWhoopLabel", "Utils")';
            const res = await fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ upc_number })
            });

            if (res.ok) {
                const result = await res.json();
                return result;
            } else {
                return "Lỗi";
            }

        }

        const printer = @Html.Raw(Json.Serialize(Model));
        const target = printer.target;
        const jsonPath = "/json/whoop.json";
        let whoopData = [];
        const fetchWhoopData = async () => {
            try {
                const response = await fetch(jsonPath);
                const data = await response.json();

                return data;
            } catch (error) {
                console.error("Error fetching Whoop data:", error);
                return null;
            }
        };
        whoopData = await fetchWhoopData();
        console.log(whoopData)

        const selectElement = document.getElementById("upcNumber");
        if (whoopData) {
            whoopData.forEach((item) => {
                const optionElement = document.createElement("option");
                optionElement.value = item.UPC;
                optionElement.textContent = `${item.UPC} - ${item.ITEM}`;
                selectElement.appendChild(optionElement);
            });
        }

        @* selectElement.addEventListener("change", async () => {
            const selectedOption = selectElement.value;
            const selectedItem = whoopData.find((item) => item.UPC.toString() === selectedOption)

            let res = await getCTfromUpc(selectedItem.UPC);
            console.log(res)
            if (selectedItem) {
                upcItem = selectedItem.ITEM;
                upcColor = selectedItem.Color;
                upcPnNumber = selectedItem.PN;
                upcNumber = selectedItem.UPC;
                if (selectedItem.Size) {
                    upcSize = selectedItem.Size;
                }

            }

        }) *@

            $('#upcNumber').select2({
                placeholder: "Chọn mã upc",
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function () {
                        return "Không tìm thấy kết quả";
                    },
                    searching: function () {
                        return "Đang tìm kiếm...";
                    }
                }
            });

        // Event handler cho Select2
        $('#upcNumber').on('select2:select', async function (e) {
            const selectedOption = e.params.data.id;
            const selectedItem = whoopData.find((item) => item.UPC.toString() === selectedOption);

            let res = await getCTfromUpc(selectedItem.UPC);
            console.log(res);

            if (selectedItem) {
                window.upcItem = selectedItem.ITEM;
                window.upcColor = selectedItem.Color;
                window.upcPnNumber = selectedItem.PN;
                window.upcNumber = selectedItem.UPC;
                if (selectedItem.Size) {
                    window.upcSize = selectedItem.Size;
                } else {
                    window.upcSize = "";
                }
            }
        });


        previewBtn.addEventListener('click', (event) => {
            event.preventDefault();
            const size = document.getElementById('sizeLabel')?.value || "";
            const width = document.getElementById('widthLabel')?.value || "";
            const height = document.getElementById('heightLabel')?.value || "";
            const desc = document.getElementById('desc')?.value || "";
            const quantity = document.getElementById('quantity')?.value || "";
            @* const upcNumber = document.getElementById('upcNumber')?.value || ""; *@
            const upcNumber = $('#upcNumber').val() || "";
            const poNumber = document.getElementById('poNumber')?.value || "";
            const ctNo = document.getElementById('ctNo')?.value || "";
            const totalCt = document.getElementById('totalCt')?.value || "";
            const ctNumber = `${ctNo} of ${totalCt}`
            const itemSize = window.upcSize;
            let dateWhoop = document.getElementById('dateWhoop')?.value || "";
            if (dateWhoop) {
                let temp = dateWhoop.split("-");
                let year = temp[0]; // Năm
                let month = parseInt(temp[1], 10); // Tháng (chuyển sang số để bỏ số 0 ở đầu nếu có)
                let date = parseInt(temp[2], 10); // Ngày (chuyển sang số để bỏ số 0 ở đầu nếu có)

                // Sắp xếp lại thứ tự để có định dạng YYYY/M/D
                dateWhoop = `${year}/${month}/${date}`;
                console.log(dateWhoop)
            }

            fetchImage(size, width, height, desc, quantity, upcNumber, poNumber, ctNumber, itemSize, dateWhoop, window.upcPnNumber, window.upcColor, window.upcItem);
        });

        printBtn.addEventListener("click", async (event) => {
            event.preventDefault();
            const printer = @Html.Raw(Json.Serialize(Model));
            const copies = document.getElementById('copies').value;

            const payload = {
                PrinterIpAddress: printer.iP_Printer,
                Port: printer.port_Printer,
                ZplCode: zplTemplate,
                Copies: copies
            }

            const url = '@Url.Action("printzpl", "Print")';

            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });
        })

        const quickPrint = async () => {
            const size = document.getElementById('sizeLabel')?.value || "";
            const width = document.getElementById('widthLabel')?.value || "";
            const height = document.getElementById('heightLabel')?.value || "";
            const desc = document.getElementById('desc')?.value || "";
            const quantity = document.getElementById('quantity')?.value || "";
            @* const upcNumber = document.getElementById('upcNumber')?.value || ""; *@
            const upcNumber = $('#upcNumber').val() || "";
            const poNumber = document.getElementById('poNumber')?.value || "";
            const ctNo = document.getElementById('ctNo')?.value || "";
            const totalCt = document.getElementById('totalCt')?.value || "";
            const ctNumber = `${ctNo} of ${totalCt}`
            const itemSize = upcSize;
            let dateWhoop = document.getElementById('dateWhoop')?.value || "";
            if (dateWhoop) {
                let temp = dateWhoop.split("-");
                let year = temp[0]; // Năm
                let month = parseInt(temp[1], 10); // Tháng (chuyển sang số để bỏ số 0 ở đầu nếu có)
                let date = parseInt(temp[2], 10); // Ngày (chuyển sang số để bỏ số 0 ở đầu nếu có)

                // Sắp xếp lại thứ tự để có định dạng YYYY/M/D
                dateWhoop = `${year}/${month}/${date}`;
                console.log(dateWhoop)
            }

            const zplTemplate = await fetchImage(size, width, height, desc, quantity, upcNumber, poNumber, ctNumber, itemSize, dateWhoop, window.upcPnNumber, window.upcColor, window.upcItem);

            const printer = @Html.Raw(Json.Serialize(Model));
            const copies = document.getElementById('copies').value;

            const payload = {
                PrinterIpAddress: printer.iP_Printer,
                Port: printer.port_Printer,
                ZplCode: zplTemplate,
                Copies: copies
            }

            const url = '@Url.Action("printzpl", "Print")';

            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });
        }

        quickBtn.addEventListener("click", async (event) => {
            event.preventDefault();
            await quickPrint();
        })

        const inMotLoatPrint = async () => {
            const size = document.getElementById('sizeLabel')?.value || "";
            const width = document.getElementById('widthLabel')?.value || "";
            const height = document.getElementById('heightLabel')?.value || "";
            const desc = document.getElementById('desc')?.value || "";
            const quantity = document.getElementById('quantity')?.value || "";
            @* const upcNumber = document.getElementById('upcNumber')?.value || ""; *@
            const upcNumber = $('#upcNumber').val() || "";
            const poNumber = document.getElementById('poNumber')?.value || "";
            const startCT = document.getElementById('startCT')?.value || "";
            const inMotLoat = document.getElementById('inMotLoat')?.value || "";
            const totalCt = document.getElementById('totalCt')?.value || "";
            const upcPnNumber = window.upcPnNumber
            const upcColor = window.upcColor
            const upcItem = window.upcItem
            const itemSize = window.upcSize


            @* const itemSize = upcSize; *@
                let dateWhoop = document.getElementById('dateWhoop')?.value || "";
            if (dateWhoop) {
                let temp = dateWhoop.split("-");
                let year = temp[0]; // Năm
                let month = parseInt(temp[1], 10); // Tháng (chuyển sang số để bỏ số 0 ở đầu nếu có)
                let date = parseInt(temp[2], 10); // Ngày (chuyển sang số để bỏ số 0 ở đầu nếu có)

                // Sắp xếp lại thứ tự để có định dạng YYYY/M/D
                dateWhoop = `${year}/${month}/${date}`;
                console.log(dateWhoop)
            }

            const urlLabel = '@Url.Action("CreateLabelNoPreview", "Utils")';
            const printer = @Html.Raw(Json.Serialize(Model));
            const copies = document.getElementById('copies').value;
            const _ = window.location.pathname.split("/");
            const id = _[_.length - 1];
            const urlPrint = '@Url.Action("printzpl", "Print")';


            for (let i = startCT; i <= inMotLoat; i++) {
                const ctNumber = `${i} of ${totalCt}`
                console.log(size, width, height, desc, quantity, upcNumber, poNumber, ctNumber, itemSize, dateWhoop, upcPnNumber, upcColor, upcItem)
                const res = await fetch(urlLabel, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ size, width, height, id, desc, quantity, upcNumber, poNumber, ctNumber, itemSize, dateWhoop, upcPnNumber, upcColor, upcItem })
                });
                if (res.ok) {
                    const result = await res.json();
                    zplTemplate = result.template;
                }
                const payload = {
                    PrinterIpAddress: printer.iP_Printer,
                    Port: printer.port_Printer,
                    ZplCode: zplTemplate,
                    Copies: copies
                }
                await fetch(urlPrint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });
            }
        }

        inMotLoatBtn.addEventListener("click", async (event) => {
            event.preventDefault();
            await inMotLoatPrint();
        })

        window.addEventListener('keydown', (e) => {
            if (e.code === 'Numpad1') {
                @* e.preventDefault();
                window.location.href = 'http://10.10.99.10:8100/tools/workorderinfo'; *@
            } else if (e.code === 'Numpad2') {
                e.preventDefault();
                window.location.href = 'http://10.10.99.10:8102/Utils/Scantocheckwithwo/whoop';
            } else if (e.code === 'Numpad3') {
                @* e.preventDefault();
                window.location.href = 'http://10.10.99.10:8102/Utils/Whoopnew/WALTER'; *@
            }
        }, { capture: true });

    });
</script>