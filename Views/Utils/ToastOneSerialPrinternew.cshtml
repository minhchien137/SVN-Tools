@model SVN_Tools.Models.Utils.PrinterData;

@{
    ViewData["Title"] = ViewBag.oper;
}

<style>
    /* Layout 2 cột: nội dung trái, indicator phải */
    .print-layout {
        display: flex;
        gap: 48px;
        align-items: flex-start;
    }

    /* Khối nội dung chính (card hiện có) */
    .print-card {
        flex: 1;
        min-width: 450px;
        /* tuỳ chỉnh theo UI của bạn */
    }

    /* Cột indicator bên phải */
    .indicator-col {
        width: 860px;
        /* chừa lề cho vòng tròn 400px + text */
    }

    .indicator-circle {
        width: 500px;
        /* gấp ~4 lần bản nhỏ */
        height: 500px;
        border-radius: 50%;
        box-shadow: 0 14px 40px rgba(0, 0, 0, .35);
        transition: background-color .15s ease;
        margin: 0 auto 16px;
    }

    .indicator-text {
        text-align: center;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: .04em;
        color: #e5e7eb;
    }

    /* Màu theo mode */
    .ind-ok {
        background: white;
    }

    /* xanh lam */
    .ind-ng {
        background: red;
    }

    /* hồng */

    /* Nháy 500ms */
    .flash-success {
        background: #22c55e !important;
    }

    /* xanh lá */
    .flash-error {
        background: #dc2626 !important;
    }

    /* đỏ */

    #msg {
        font-size: 24px;
        /* To và dễ đọc */
        font-weight: 700;
        /* Đậm */
        text-align: center;
        /* Canh giữa */
        padding: 18px 40px !important;
        /* Dày hơn */
        border-radius: 14px;
        margin-bottom: 20px;
        display: none;
        color: #fff !important;
        /* Text trắng */
        box-shadow: 0 0 25px rgba(0, 0, 0, .5);
        transition: all .3s ease;
    }

    /* SUCCESS */
    #msg.show-success {
        background: #16a34a !important;
        /* xanh lá đậm */
        border: 6px solid green;
        animation: borderBlinkGreen 1s infinite;
    }

    /* ERROR */
    #msg.show-error {
        background: #dc2626 !important;
        /* đỏ đậm */
        border: 6px solid red;
        animation: borderBlinkRed 1s infinite;
    }

    /* Hiệu ứng nhấp nháy viền */
    @@keyframes borderBlinkGreen {

        0%,
        100% {
            border-color: green;
            @* box-shadow: 0 0 15px #22c55e; *@
        }

        50% {
            border-color: white;
            @* box-shadow: 0 0 25px #bbf7d0; *@
        }
    }

    @@keyframes borderBlinkRed {

        0%,
        100% {
            border-color: red;
            @* box-shadow: 0 0 15px #f87171; *@
        }

        50% {
            border-color: white;
            @* box-shadow: 0 0 25px #fecaca; *@
        }
    }
</style>

<h1>@ViewBag.oper</h1>

<div class="print-layout">
    <!-- Cột trái: nội dung hiện có -->
    <div class="print-card">
        <div>
            <h4>Printer Details</h4>
            <hr />
            <div class="row">
                <div class="col-6">
                    <div class="row">
                        <div class="col-3">
                            Name:
                        </div>
                        <div class="col-9">
                            @Html.DisplayFor(model => model.Name_Printer)
                        </div>
                        <div class="col-3">
                            IP:
                        </div>
                        <div class="col-9">
                            @Html.DisplayFor(model => model.IP_Printer)
                        </div>
                        <div class="col-3">
                            Port:
                        </div>
                        <div class="col-9">
                            @Html.DisplayFor(model => model.Port_Printer)
                        </div>
                        <div class="col-3">
                            Size:
                        </div>
                        <div class="col-9">
                            @Html.DisplayFor(model => model.Size)
                        </div>
                        <div class="col-3">
                            WxH (inch):
                        </div>
                        <div class="col-9">
                            @Html.DisplayFor(model => model.width) x @Html.DisplayFor(model => model.height)
                        </div>
                        <hr />
                        <div class="col-3 mb-2">
                            <label for="copies">Copies:</label>
                        </div>
                        <div class="col-9 mb-2">
                            <input type="text" id="copies" placeholder="Copies" value="1" style="width: 60%;height:42px"
                                required />
                        </div>
                        <div class="col-3 mb-2">
                            <label for="upcNumber">SKU:</label>
                        </div>
                        <div class="col-9 mb-2">
                            <input type="text" id="upcNumber" placeholder="SKU" style="width: 60%;height:42px"
                                required />
                        </div>
                        <div class="col-3 mb-2">
                            <label for="lotId">Lot Id:</label>
                        </div>
                        <div class="col-9 mb-2">
                            <input type="text" id="lotId" placeholder="Lot Id" style="width: 60%;height:42px"
                                required />
                            <button class=" btn btn-primary" id="lotIdSaveBtn" style="margin-top: -6px">Save</button>
                        </div>
                        <div class=" col-3 mb-2">
                            <label for="serialNumber">SN:</label>
                        </div>
                        <div class="col-9 mb-2">
                            <input type="text" id="serialNumber" placeholder="Serial Number"
                                style="width: 60%;height:42px;" required />
                            <button class="btn btn-primary" id="reprint" style="margin-top: -6px">In lại</button>
                        </div>
                        <div id="msg" style="display:none;"></div>
                    </div>
                </div>
            </div>
            <div>
                <button class="btn btn-warning" style="margin-top: 200px;">
                    <a asp-action="UltimatePrint">Back to List</a>
                </button>
            </div>
        </div>
    </div>

    <!-- Cột phải: Indicator -->
    <aside class="indicator-col">
        <div id="indicatorCircle" class="indicator-circle ind-ok" aria-label="indicator"></div>
        <div id="indicatorText" class="indicator-text">OK MODE</div>
    </aside>
</div>




<script>
    document.addEventListener('DOMContentLoaded', async function () {
        const saveLotIdBtn = document.getElementById('lotIdSaveBtn');
        const serialNumberInput = document.getElementById('serialNumber');
        const reprintBtn = document.getElementById('reprint');
        const indicator = document.getElementById('indicatorCircle');
        const indicatorText = document.getElementById('indicatorText');

        const DEBOUNCE_DELAY = 300;
        let timerId;
        let flashTimer;

        // NG mode lưu localStorage
        let ngMode = localStorage.getItem('fqc_ng_mode') === '1';

        // --- Indicator helpers ---
        function setIndicatorBase() {
            indicator.classList.remove('ind-ok', 'ind-ng', 'flash-success', 'flash-error');
            if (ngMode) {
                indicator.classList.add('ind-ng');
                indicatorText.textContent = 'NG MODE';
            } else {
                indicator.classList.add('ind-ok');
                indicatorText.textContent = 'OK MODE';
            }
        }
        function flashIndicator(kind /* 'success' | 'error' */) {
            if (flashTimer) { clearTimeout(flashTimer); flashTimer = null; }
            // bỏ màu nháy cũ, gắn màu nháy mới
            indicator.classList.remove('flash-success', 'flash-error');
            indicator.classList.add(kind === 'success' ? 'flash-success' : 'flash-error');
            // 500ms rồi trở về màu theo mode
            flashTimer = setTimeout(() => {
                indicator.classList.remove('flash-success', 'flash-error');
                setIndicatorBase();
            }, 3000);
        }

        function updateVisualMode() {
            // viền input để operator dễ nhận ra
            serialNumberInput.style.borderColor = ngMode ? '#ef4444' : '#cbd5e1';
            serialNumberInput.style.backgroundColor = ngMode ? '#fee2e2' : 'white';
            setIndicatorBase();
        }
        function toggleNgMode() {
            ngMode = !ngMode;
            localStorage.setItem('fqc_ng_mode', ngMode ? '1' : '0');
            updateVisualMode();
        }
        updateVisualMode();

        // LotId save/restore
        const checkLotId = () => {
            const lotIdInput = document.getElementById('lotId');
            const lotIdValueInLS = localStorage.getItem('lotIdToastOneSerial');
            const skuInput = document.getElementById('upcNumber');
            const skuValueInLS = localStorage.getItem('skuToastOneSerial');
            if (lotIdValueInLS) lotIdInput.value = lotIdValueInLS;
            if (skuValueInLS) skuInput.value = skuValueInLS;
        };
        checkLotId();

        const saveLotId = () => {
            const lotIdInput = document.getElementById('lotId');
            localStorage.setItem('lotIdToastOneSerial', lotIdInput.value);
            const skuInput = document.getElementById('upcNumber');
            localStorage.setItem('skuToastOneSerial', skuInput.value);
        };
        saveLotIdBtn.addEventListener('click', saveLotId);


        // API: update FQC status
        const updateFqcStatus = async (serialNumber, status) => {
            const url = '@Url.Action("UpdateFqcStatus", "Utils")';
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ serialNumber, status })
            });
            return await res.json(); // { ok: bool, message? }
        };

       

        // In ZPL (giữ logic cũ)
        async function doPrint(serialNumber) {
            const lotId = document.getElementById('lotId').value;
            const upcNumber = document.getElementById('upcNumber').value;
            const printer = @Html.Raw(Json.Serialize(Model));
            const copies = document.getElementById('copies').value;
            let zplTemplate = printer.zpL_Temp.toString();

            const result = serialNumber.match(/^([A-Z0-9]{2})(\d{4})([A-Z0-9]{1})(\d{6})$/);
            if (!result) throw new Error('Serial không đúng định dạng.');

            // ✅ encodedSerial tính trong doPrint, dùng serialNumber từ tham số
            const fmt = serialNumber.match(/^([A-Z])(\d{12})$/);
            const encodedSerial = fmt ? `${fmt[1]}>5${fmt[2]}` : '';

            const upcNumbers = upcNumber.match(/^([A-Z]+)(\d+)$/);
            if (!upcNumbers) throw new Error('SKU không đúng định dạng.');

            const lotIds = lotId.split('-');
            zplTemplate = zplTemplate
                .replaceAll('{lotId}', lotId)
                .replaceAll('{serialNumber}', serialNumber)
                .replaceAll('{lotId1}', lotIds[0] || '')
                .replaceAll('{lotId2}', lotIds[1] || '')
                .replaceAll('{lotId3}', lotIds[2] || '')
                .replaceAll('{sn}', encodedSerial)
                .replaceAll('{upcNumber}', upcNumber)
                .replaceAll('{upcNumber1}', upcNumbers[1])
                .replaceAll('{upcNumber2}', upcNumbers[2]);

            const payload = {
                PrinterIpAddress: printer.iP_Printer,
                Port: printer.port_Printer,
                ZplCode: zplTemplate,
                Copies: copies
            };

            const url = '@Url.Action("printzpl", "Print")';
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!res.ok) throw new Error('Gửi lệnh in thất bại.');
        }

        // Xử lý scan
        const handleScan = async () => {
            const raw = serialNumberInput.value.trim();
            if (!raw) return;

            // Toggle NG khi quét "NG"
            if (raw.toUpperCase() === 'NG') {
                toggleNgMode();
                serialNumberInput.value = '';
                return;
            }

            // Chỉ nhận serial 13 ký tự
            if (raw.length !== 13) {
                flashIndicator('error');
                showMsg('Serial không hợp lệ.', true);
                serialNumberInput.value = '';
                return;
            }

            // Check đã qua FCT
            @* let check;
            try {
                check = await checkSerialNumber(raw);
            } catch {
                flashIndicator('error');
                showMsg('Không gọi được API kiểm tra serial.');
                serialNumberInput.value = '';
                return;
            }
            if (!check?.result) {
                flashIndicator('error');
                showMsg('Serial không hợp lệ (chưa qua FCT hoặc sai).');
                serialNumberInput.value = '';
                return;
            } *@

            // Update FQC trước
            try {
                const upd = await updateFqcStatus(raw, ngMode ? 'NG' : 'OK');

                if (!upd?.ok) {
                    flashIndicator('error');
                    showMsg(upd?.message || 'Cập nhật FQC thất bại.', true);
                    serialNumberInput.value = '';
                    return;
                }

                // ✅ Thành công
                flashIndicator('success');
                showMsg(upd?.message || 'Cập nhật FQC thành công.', false);

            } catch {
                flashIndicator('error');
                showMsg('Không gọi được API cập nhật FQC.', true);
                serialNumberInput.value = '';
                return;
            }

            // Nếu NG mode -> lưu NG, sau đó tự chuyển về OK mode
            if (ngMode) {
                flashIndicator('success'); // lưu NG thành công
                localStorage.setItem('fqc_ng_mode', '0');
                serialNumberInput.value = '';
                setTimeout(() => {
                    ngMode = false;
                    updateVisualMode(); // cập nhật giao diện
                }, 600)
                return;
            }

            // OK mode -> in
            try {
                await doPrint(raw);
                flashIndicator('success'); // in OK thành công
            } catch (e) {
                flashIndicator('error');
                showMsg(e.message || 'In thất bại.', true);
            }
            serialNumberInput.value = '';
        };

        function showMsg(text, isError = false) {
            const msg = document.getElementById('msg');
            msg.style.display = 'block';
            msg.textContent = text;
            msg.classList.remove('show-success', 'show-error');
            msg.classList.add(isError ? 'show-error' : 'show-success');

            // Tự ẩn sau 3 giây
            @* clearTimeout(msg._hideTimer);
            msg._hideTimer = setTimeout(() => {
                msg.style.display = 'none';
            }, 3000); *@
        }

        // Debounce input (scanner sẽ đổ text rất nhanh)
        serialNumberInput.addEventListener('keydown', async (e) => {
            if (e.key === 'Enter') {
                e.preventDefault(); // chặn Enter gây submit form
                const value = serialNumberInput.value.trim();
                if (value !== '') {
                    localStorage.setItem('lastSerialNumber', value);
                    await handleScan();
                }
            }
        });

        // In lại
        reprintBtn.addEventListener('click', async () => {
            const serialNumber = localStorage.getItem('lastSerialNumber');
            if (!serialNumber) {
                flashIndicator('error');
                showMsg('Không có serial để in lại.', true);
                return;
            }
            try {
                await doPrint(serialNumber);
                flashIndicator('success');
            } catch (e) {
                flashIndicator('error');
                showMsg(e.message || 'In thất bại.', true);
            }
        });
    });
</script>