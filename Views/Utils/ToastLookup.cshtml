@{
    ViewData["Title"] = "Tra cứu thông tin Toast";
}

<style>
    body { font-family: 'Segoe UI', sans-serif; background: #0f1115; color: #f9fafb; margin: 0; padding: 32px 20px; }

    .page-title {
        font-size: 34px; font-weight: 800; margin: 0 0 28px; letter-spacing: -.5px;
        text-align: center;
        background: linear-gradient(90deg, #60a5fa, #93c5fd);
        -webkit-background-clip: text; background-clip: text; color: transparent;
    }

    .search-bar {
        display: flex; gap: 10px; max-width: 620px; margin: 0 auto 36px;
    }
    .search-bar input {
        flex: 1; background: #1f2937; border: 1px solid #374151; border-radius: 10px;
        color: #f9fafb; padding: 14px 18px; font-size: 17px; outline: none; letter-spacing: .5px;
    }
    .search-bar input:focus { border-color: #3b82f6; }
    .search-bar button {
        background: #2563eb; color: #fff; border: none; border-radius: 10px;
        padding: 0 26px; font-size: 15px; font-weight: 600; cursor: pointer;
    }
    .search-bar button:hover { background: #1d4ed8; }

    #result-area { max-width: 960px; margin: 0 auto; }

    .not-found {
        text-align: center; color: #6b7280; padding: 60px 0; font-size: 17px;
    }

    /* Journey timeline */
    .journey {
        display: flex; align-items: flex-start; gap: 0; margin-bottom: 28px;
        overflow-x: auto; padding-bottom: 4px;
    }
    .journey-step {
        flex: 1; min-width: 140px;
    }
    .journey-connector {
        width: 40px; flex-shrink: 0; display: flex; align-items: center;
        justify-content: center; padding-top: 22px;
    }
    .journey-connector svg { color: #374151; }
    .step-icon {
        width: 44px; height: 44px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; margin: 0 auto 8px; border: 2px solid #374151;
        background: #1f2937;
    }
    .step-icon.done   { background: #14532d; border-color: #16a34a; }
    .step-icon.fail   { background: #7f1d1d; border-color: #dc2626; }
    .step-icon.skip   { background: #1f2937; border-color: #374151; opacity:.5; }
    .step-label { text-align: center; font-size: 15px; color: #e5e7eb; font-weight: 700; letter-spacing:.5px; text-transform: uppercase; }
    .step-status { text-align: center; font-size: 13px; font-weight: 700; margin-top: 4px; }
    .step-time  { text-align: center; font-size: 11px; color: #6b7280; margin-top: 2px; }

    /* Cards grid */
    .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    @@media (max-width: 680px) { .cards { grid-template-columns: 1fr; } }

    .card {
        background: #1f2937; border: 1px solid #374151; border-radius: 14px; padding: 20px;
    }
    .card-title {
        font-size: 13px; font-weight: 700; color: #9ca3af; text-transform: uppercase;
        letter-spacing: .6px; margin: 0 0 16px; display: flex; align-items: center; gap: 8px;
    }
    .card-title span { font-size: 16px; }

    .info-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 7px 0; border-bottom: 1px solid #2d3748; gap: 12px; }
    .info-row:last-child { border-bottom: none; }
    .info-label { font-size: 12px; color: #cbd5e1; font-weight: 600; white-space: nowrap; flex-shrink: 0; }
    .info-val { font-size: 13px; font-weight: 600; text-align: right; word-break: break-all; }

    .badge { padding: 3px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; display: inline-block; }
    .badge-ok   { background: #14532d; color: #86efac; }
    .badge-ng   { background: #7f1d1d; color: #fca5a5; }
    .badge-none { background: #1f2937; color: #6b7280; border: 1px solid #374151; }

    .pallet-serials {
        display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px;
    }
    .serial-chip {
        background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.4); border-radius: 6px;
        padding: 4px 10px; font-size: 12px; font-family: monospace; font-weight: 700; color: #86efac;
        cursor: pointer;
    }
    .serial-chip.current { border-color: #3b82f6; color: #93c5fd; background: #1e3a5f; }
    .serial-chip:hover { border-color: #4ade80; background: rgba(34,197,94,.2); }
    .serial-chip.current:hover { border-color: #60a5fa; background: #1e3a5f; }

    .comp-box {
        margin-top: 12px; padding: 12px; border-radius: 10px;
        background: rgba(59,130,246,.08); border: 1px solid rgba(59,130,246,.35);
    }
    .comp-box-title { font-size: 12px; color: #93c5fd; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 8px; }
    .comp-list { display: flex; flex-direction: column; gap: 5px; }
    .comp-item { font-size: 12px; color: #9ca3af; font-family: monospace; background: #111827; padding: 5px 10px; border-radius: 6px; }
    .comp-code { color: #93c5fd; font-weight: 700; }
    .comp-name { color: #f9fafb; font-weight: 600; }
    .comp-lot  { color: #fbbf24; font-weight: 700; }
    .comp-sep  { color: #4b5563; }

    .mt-badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: 700; margin: 1px 3px 1px 0; white-space: nowrap; }

    .full-card { grid-column: 1 / -1; }

    #loading { text-align: center; color: #6b7280; padding: 40px; display: none; font-size: 15px; }

    .btn-blue {
        background: #2563eb; color: #fff; border: none; border-radius: 8px;
        font-weight: 600; cursor: pointer;
    }
    .btn-blue:hover { background: #1d4ed8; }

    .btn-gray {
        background: #1f2937; color: #e5e7eb; border: 1px solid #4b5563;
        border-radius: 8px; font-weight: 600; cursor: pointer;
    }
    .btn-gray:hover:not(:disabled) { background: #2563eb; border-color: #2563eb; color: #fff; }
    .btn-gray:active:not(:disabled) { background: #1d4ed8; border-color: #1d4ed8; color: #fff; }
    .btn-gray:disabled { opacity: .35; cursor: not-allowed; }
</style>

<div style="max-width:960px;margin:0 auto;">
    <div class="page-title">Tra cứu thông tin Toast</div>

    <div class="search-bar">
        <input type="text" id="inp-q" placeholder="Scan hoặc nhập serial / pallet ID..." autofocus />
        <button onclick="doSearch()">Tìm kiếm</button>
    </div>

    <div id="loading">Đang tải...</div>
    <div id="result-area"></div>
</div>

<script>
    document.getElementById('inp-q').addEventListener('keydown', e => {
        if (e.key === 'Enter') doSearch();
    });

    function fmtDate(str) {
        if (!str) return '—';
        const d = new Date(str);
        return d.toLocaleString('vi-VN', { hour12: false });
    }

    function badgeHtml(status) {
        if (!status) return '<span class="badge badge-none">Chưa có</span>';
        const s = status.toUpperCase();
        if (s === 'OK') return '<span class="badge badge-ok">OK</span>';
        if (s === 'NG') return '<span class="badge badge-ng">NG</span>';
        return `<span class="badge badge-none">${status}</span>`;
    }

    function stepIcon(status) {
        if (!status) return `<div class="step-icon skip">–</div>`;
        return status.toUpperCase() === 'OK'
            ? `<div class="step-icon done">✓</div>`
            : `<div class="step-icon fail">✕</div>`;
    }

    function parseComponents(list) {
        if (!list || !list.length) return '';
        return list.map(c => {
            const label = c.productCode
                ? `<span class="comp-code">[${c.productCode}]</span> <span class="comp-name">${c.productName || ''}</span>`
                : `<span class="comp-name">product_id: ${c.productId}</span>`;
            return `<div class="comp-item">${label} <span class="comp-sep">|</span> lot: <span class="comp-lot">${c.lotNumber}</span></div>`;
        }).join('');
    }

    function connector() {
        return `<div class="journey-connector">
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
        </div>`;
    }

    function buildJourney(d) {
        const fct = d.fctFqc;
        const fq  = d.fctFqc;
        const wip = d.wip;
        const fg  = d.fg;
        const pal = d.pallet;

        const steps = [
            {
                label: 'Trạm WIP',
                status: wip ? 'OK' : null,
                time: wip ? fmtDate(wip.dateFinished) : '—'
            },
            {
                label: 'Trạm FCT',
                status: fct?.fctStatus,
                time: fmtDate(fct?.fctDatetime)
            },
            {
                label: 'Trạm FQC',
                status: fct?.fqcStatus,
                time: fmtDate(fct?.fqcDatetime)
            },
            {
                label: 'Trạm FG',
                status: fg ? 'OK' : null,
                time: fg ? fmtDate(fg.dateFinished) : '—'
            },
            {
                label: 'Trạm Đóng gói',
                status: pal ? 'OK' : null,
                time: pal ? pal.scanDate : '—'
            }
        ];

        let html = '<div class="journey">';
        steps.forEach((s, i) => {
            html += `<div class="journey-step">
                ${stepIcon(s.status)}
                <div class="step-label">${s.label}</div>
                <div class="step-status" style="color:${s.status ? (s.status.toUpperCase()==='OK'?'#86efac':'#fca5a5') : '#4b5563'}">
                    ${s.status ? (s.status.toUpperCase()==='OK'?'Đạt':'Lỗi') : 'Chưa có'}
                </div>
                <div class="step-time">${s.time}</div>
            </div>`;
            if (i < steps.length - 1) html += connector();
        });
        html += '</div>';
        return html;
    }

    function buildCards(d) {
        let html = '<div class="cards">';

        // FCT / FQC
        const f = d.fctFqc;
        html += `<div class="card">
            <div class="card-title">FCT / FQC</div>`;
        if (!f) {
            html += `<div style="color:#6b7280;font-size:13px;">Chưa có dữ liệu FCT/FQC</div>`;
        } else {
            html += `
            <div class="info-row"><span class="info-label">Work Order</span><span class="info-val">${f.workOrder||'—'}</span></div>
            <div class="info-row"><span class="info-label">FCT Status</span><span class="info-val">${badgeHtml(f.fctStatus)}</span></div>
            <div class="info-row"><span class="info-label">FCT Thời gian</span><span class="info-val" style="color:#9ca3af">${fmtDate(f.fctDatetime)}</span></div>
            <div class="info-row"><span class="info-label">FQC Status</span><span class="info-val">${badgeHtml(f.fqcStatus)}</span></div>
            <div class="info-row"><span class="info-label">FQC Thời gian</span><span class="info-val" style="color:#9ca3af">${fmtDate(f.fqcDatetime)}</span></div>`;
        }
        html += `</div>`;

        // Pallet
        const p = d.pallet;
        html += `<div class="card">
            <div class="card-title">Thông tin Đóng gói</div>`;
        if (!p) {
            html += `<div style="color:#6b7280;font-size:13px;">Chưa đóng pallet</div>`;
        } else {
            html += `
            <div class="info-row"><span class="info-label">Pallet ID</span><span class="info-val" style="color:#60a5fa;font-size:15px;">${p.palletID}</span></div>
            <div class="info-row"><span class="info-label">Ngày đóng</span><span class="info-val">${p.date}</span></div>
            <div class="info-row"><span class="info-label">Thời gian scan</span><span class="info-val" style="color:#9ca3af">${p.scanDate}</span></div>            <div class="info-row"><span class="info-label">Tổng serial</span><span class="info-val">${p.countSerial}</span></div>
            <div style="margin-top:10px;font-size:12px;color:#6b7280;margin-bottom:6px;">Các serial trong pallet:</div>
            <div class="pallet-serials">
                ${(p.serials||[]).map(s => `<span class="serial-chip ${s.trim()===d.serial?'current':''}" onclick="searchSerial('${s.trim()}')">${s.trim()}</span>`).join('')}
            </div>`;
        }
        html += `</div>`;

        // WIP
        const w = d.wip;
        html += `<div class="card">
            <div class="card-title">Trạm WIP</div>`;
        if (!w) {
            html += `<div style="color:#6b7280;font-size:13px;">Chưa có log WIP</div>`;
        } else {
            html += `
            <div class="info-row"><span class="info-label">WO Code</span><span class="info-val" style="color:#a78bfa">${w.woCode}</span></div>
            <div class="info-row"><span class="info-label">WO cha</span><span class="info-val">${w.masterWoCode}</span></div>
            <div class="info-row"><span class="info-label">Thời gian</span><span class="info-val" style="color:#9ca3af">${fmtDate(w.dateFinished)}</span></div>
            <div class="info-row"><span class="info-label">Trạng thái đồng bộ</span><span class="info-val"><span class="badge ${w.status==='synch success'?'badge-ok':'badge-ng'}">${w.status==='synch success'?'Thành công':'Thất bại'}</span></span></div>
            <div class="info-row"><span class="info-label">FG WO (tiêu thụ)</span><span class="info-val" style="color:#f59e0b;font-size:12px;">${w.consumedWoCode||'—'}</span></div>
            <div class="comp-box">
                <div class="comp-box-title">Linh kiện</div>
                <div class="comp-list">${parseComponents(w.componentList)}</div>
            </div>`;
        }
        html += `</div>`;

        // FG
        const g = d.fg;
        html += `<div class="card">
            <div class="card-title">Trạm FG</div>`;
        if (!g) {
            html += `<div style="color:#6b7280;font-size:13px;">Chưa có log FG</div>`;
        } else {
            html += `
            <div class="info-row"><span class="info-label">WO Code</span><span class="info-val" style="color:#a78bfa">${g.woCode}</span></div>
            <div class="info-row"><span class="info-label">WO cha</span><span class="info-val">${g.masterWoCode}</span></div>
            <div class="info-row"><span class="info-label">Thời gian</span><span class="info-val" style="color:#9ca3af">${fmtDate(g.dateFinished)}</span></div>
            <div class="info-row"><span class="info-label">Trạng thái đồng bộ</span><span class="info-val"><span class="badge ${g.status==='synch success'?'badge-ok':'badge-ng'}">${g.status==='synch success'?'Thành công':'Thất bại'}</span></span></div>
            <div class="comp-box">
                <div class="comp-box-title">Linh kiện</div>
                <div class="comp-list">${parseComponents(g.componentList)}</div>
            </div>`;
        }
        html += `</div>`;

        html += '</div>';
        return html;
    }

    async function doSearch() {
        const q = document.getElementById('inp-q').value.trim();
        if (!q) return;

        document.getElementById('loading').style.display = 'block';
        document.getElementById('result-area').innerHTML = '';

        try {
            const res = await fetch(`/api/ToastLookup?q=${encodeURIComponent(q)}`);
            const data = await res.json();
            document.getElementById('loading').style.display = 'none';

            if (!data.found) {
                document.getElementById('result-area').innerHTML =
                    `<div class="not-found">Không tìm thấy dữ liệu cho <strong>${q}</strong></div>`;
                return;
            }

            if (data.mode === 'list') {
                renderList(data.serials, q);
            } else {
                renderDetail(data);
            }
        } catch(e) {
            document.getElementById('loading').style.display = 'none';
            document.getElementById('result-area').innerHTML =
                `<div class="not-found" style="color:#fca5a5;">Lỗi kết nối: ${e.message}</div>`;
        }
    }

    const PAGE_SIZE = 10;
    let _listData = [];
    let _currentPage = 1;
    let _filterText = '';

    function renderList(serials, q) {
        _listData = serials;
        _currentPage = 1;
        _filterText = '';

        const header = `<div style="font-size:13px;color:#6b7280;margin-bottom:16px;">
            Tìm thấy <span style="color:#f9fafb;font-weight:700;" id="list-count">${serials.length}</span> kết quả cho <strong>${q}</strong>
        </div>
        <div class="card" style="max-width:100%;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:10px;">
                <div class="card-title" style="margin:0;"><span>🔎</span> Danh sách kết quả</div>
                <input id="list-filter" type="text" placeholder="Lọc nhanh serial / WO / pallet / lot..."
                    oninput="applyFilter(this.value)"
                    style="background:#111827;border:1px solid #374151;border-radius:8px;color:#f9fafb;
                           padding:8px 14px;font-size:13px;outline:none;width:280px;" />
            </div>
            <table style="width:100%;border-collapse:collapse;">
                <thead>
                    <tr>
                        <th style="padding:10px 12px;text-align:left;color:#6b7280;font-size:12px;border-bottom:1px solid #374151;">#</th>
                        <th style="padding:10px 12px;text-align:left;color:#6b7280;font-size:12px;border-bottom:1px solid #374151;">Serial</th>
                        <th style="padding:10px 12px;text-align:left;color:#6b7280;font-size:12px;border-bottom:1px solid #374151;">FCT</th>
                        <th style="padding:10px 12px;text-align:left;color:#6b7280;font-size:12px;border-bottom:1px solid #374151;">FQC</th>
                        <th style="padding:10px 12px;text-align:left;color:#6b7280;font-size:12px;border-bottom:1px solid #374151;">Work Order</th>
                        <th style="padding:10px 12px;text-align:left;color:#6b7280;font-size:12px;border-bottom:1px solid #374151;">Pallet</th>
                        <th style="padding:10px 12px;text-align:left;color:#6b7280;font-size:12px;border-bottom:1px solid #374151;">Lot</th>
                        <th style="padding:10px 12px;text-align:left;color:#6b7280;font-size:12px;border-bottom:1px solid #374151;">Khớp theo</th>
                        <th style="padding:10px 12px;text-align:left;color:#6b7280;font-size:12px;border-bottom:1px solid #374151;"></th>
                    </tr>
                </thead>
                <tbody id="list-tbody"></tbody>
            </table>
            <div id="list-pagination" style="display:flex;align-items:center;justify-content:space-between;margin-top:14px;flex-wrap:wrap;gap:8px;"></div>
        </div>`;

        document.getElementById('result-area').innerHTML = header;
        renderListPage();
    }

    function applyFilter(val) {
        _filterText = val.toLowerCase();
        _currentPage = 1;
        renderListPage();
    }

    const MATCH_TYPE_COLORS = [
        { prefix: 'Serial',      bg: 'rgba(59,130,246,.15)',  fg: '#93c5fd' },
        { prefix: 'Work Order',  bg: 'rgba(167,139,250,.15)', fg: '#a78bfa' },
        { prefix: 'Pallet',      bg: 'rgba(34,197,94,.15)',   fg: '#86efac' },
        { prefix: 'Lot',         bg: 'rgba(251,191,36,.15)',  fg: '#fbbf24' },
        { prefix: 'Trạng thái',  bg: 'rgba(248,113,113,.15)', fg: '#fca5a5' },
        { prefix: 'Nhân viên',   bg: 'rgba(156,163,175,.15)', fg: '#d1d5db' }
    ];
    function matchTypeBadges(matchTypes) {
        if (!matchTypes) return '—';
        return matchTypes.split(',').map(t => t.trim()).filter(Boolean).map(t => {
            const c = MATCH_TYPE_COLORS.find(x => t.indexOf(x.prefix) === 0) || { bg: 'rgba(156,163,175,.15)', fg: '#d1d5db' };
            return `<span class="mt-badge" style="background:${c.bg};color:${c.fg};">${t}</span>`;
        }).join('');
    }

    function extractLots(rawText) {
        if (!rawText) return [];
        const lots = new Set();
        const re = /"lotNumber"\s*:\s*"([^"]*)"/g;
        let m;
        while ((m = re.exec(rawText)) !== null) {
            if (m[1]) lots.add(m[1]);
        }
        return [...lots];
    }

    function renderListPage() {
        const filtered = _listData.filter(r =>
            !_filterText ||
            (r.serial_number || '').toLowerCase().includes(_filterText) ||
            (r.work_order    || '').toLowerCase().includes(_filterText) ||
            (r.PalletID      || '').toLowerCase().includes(_filterText) ||
            (r.FCT_status    || '').toLowerCase().includes(_filterText) ||
            (r.FQC_status    || '').toLowerCase().includes(_filterText) ||
            (r.lots_raw      || '').toLowerCase().includes(_filterText)
        );

        const countEl = document.getElementById('list-count');
        if (countEl) countEl.textContent = filtered.length;

        const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
        if (_currentPage > totalPages) _currentPage = totalPages;

        const start = (_currentPage - 1) * PAGE_SIZE;
        const pageRows = filtered.slice(start, start + PAGE_SIZE);

        const tbody = document.getElementById('list-tbody');
        if (!pageRows.length) {
            tbody.innerHTML = `<tr><td colspan="9" style="padding:20px;text-align:center;color:#6b7280;">Không có kết quả</td></tr>`;
        } else {
            tbody.innerHTML = pageRows.map((r, i) => {
                const lots = extractLots(r.lots_raw);
                const lotsHtml = lots.length
                    ? lots.filter(l => !_filterText || l.toLowerCase().includes(_filterText))
                          .map(l => `<span class="comp-lot" style="font-family:monospace;font-size:11px;">${l}</span>`).join('<br>')
                    : '—';
                return `
                <tr style="border-bottom:1px solid #1f2937;">
                    <td style="padding:10px 12px;font-size:12px;color:#4b5563;">${start + i + 1}</td>
                    <td style="padding:10px 12px;font-family:monospace;font-size:13px;color:#93c5fd;">
                        ${r.serial_number || '—'}
                        ${r.renamed_to ? `<span class="mt-badge" style="background:rgba(248,113,113,.15);color:#fca5a5;" title="Đã đổi sang ${r.renamed_to}">Đã đổi SN</span>` : ''}
                    </td>
                    <td style="padding:10px 12px;">${badgeHtml(r.FCT_status)}</td>
                    <td style="padding:10px 12px;">${badgeHtml(r.FQC_status)}</td>
                    <td style="padding:10px 12px;font-size:12px;color:#9ca3af;">${r.work_order || '—'}</td>
                    <td style="padding:10px 12px;font-size:12px;color:#9ca3af;">${r.PalletID || '—'}</td>
                    <td style="padding:10px 12px;">${lotsHtml}</td>
                    <td style="padding:10px 12px;">${matchTypeBadges(r.match_types)}</td>
                    <td style="padding:10px 12px;">
                        <button class="btn btn-blue" style="font-size:12px;padding:5px 14px;"
                            onclick="loadDetail('${r.serial_number}')">Chi tiết</button>
                    </td>
                </tr>`;
            }).join('');
        }

        // Pagination
        const pag = document.getElementById('list-pagination');
        const info = `<span style="font-size:12px;color:#6b7280;">Trang ${_currentPage}/${totalPages} &nbsp;·&nbsp; ${filtered.length} dòng</span>`;
        let btns = `<div style="display:flex;gap:6px;">`;
        btns += `<button class="btn btn-gray" style="font-size:12px;padding:5px 12px;" onclick="goPage(1)" ${_currentPage===1?'disabled':''}>«</button>`;
        btns += `<button class="btn btn-gray" style="font-size:12px;padding:5px 12px;" onclick="goPage(${_currentPage-1})" ${_currentPage===1?'disabled':''}>‹</button>`;
        btns += `<button class="btn btn-gray" style="font-size:12px;padding:5px 12px;" onclick="goPage(${_currentPage+1})" ${_currentPage===totalPages?'disabled':''}>›</button>`;
        btns += `<button class="btn btn-gray" style="font-size:12px;padding:5px 12px;" onclick="goPage(${totalPages})" ${_currentPage===totalPages?'disabled':''}>»</button>`;
        btns += `</div>`;
        pag.innerHTML = info + btns;
    }

    function goPage(p) {
        _currentPage = p;
        renderListPage();
    }

    async function loadDetail(serial) {
        document.getElementById('loading').style.display = 'block';
        document.getElementById('result-area').innerHTML = '';

        const res = await fetch(`/api/ToastLookup/detail?serial=${encodeURIComponent(serial)}`);
        const data = await res.json();
        document.getElementById('loading').style.display = 'none';
        renderDetail(data);
    }

    function renderDetail(data) {
        let html = `<div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
            <div style="font-size:13px;color:#6b7280;">
                Serial: <span style="color:#f9fafb;font-weight:700;font-family:monospace;font-size:15px;">${data.serial}</span>
            </div>
            <button class="btn btn-blue" style="font-size:12px;padding:5px 14px;" onclick="backToSearch()">← Quay lại</button>
        </div>`;
        if (data.matchInfo) {
            const mi = data.matchInfo;
            let noteBody;
            if (mi.components && mi.components.length) {
                noteBody = mi.components.map(c => {
                    const who = c.productCode ? `<strong>[${c.productCode}]</strong> ${c.productName || ''}` : 'linh kiện';
                    return `Tìm thấy vì khớp <strong>Lot (${c.station})</strong> của ${who} với từ khóa "<strong>${mi.query}</strong>"`;
                }).join('<br>');
            } else {
                noteBody = `Tìm thấy vì khớp <strong>${mi.types}</strong> với từ khóa "<strong>${mi.query}</strong>", không phải khớp trực tiếp Serial.`;
            }
            html += `<div style="font-size:12px;color:#fbbf24;background:rgba(251,191,36,.1);
                        border:1px solid rgba(251,191,36,.35);border-radius:8px;padding:8px 14px;margin-bottom:16px;">
                ${noteBody}
            </div>`;
        }
        if (data.renameInfo && data.renameInfo.renamedTo) {
            const rt = data.renameInfo.renamedTo;
            html += `<div style="font-size:12px;color:#fca5a5;background:rgba(248,113,113,.1);
                        border:1px solid rgba(248,113,113,.35);border-radius:8px;padding:8px 14px;margin-bottom:16px;
                        display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
                <span>⚠ SN này đã được đổi sang <strong>${rt.newSerial}</strong> (lý do: ${rt.reason || '—'}, lúc: ${fmtDate(rt.editedAt)}).</span>
                <button class="btn btn-blue" style="font-size:11px;padding:4px 12px;" onclick="searchSerial('${rt.newSerial}')">Xem SN mới →</button>
            </div>`;
        }
        if (data.renameInfo && data.renameInfo.renamedFrom) {
            const rf = data.renameInfo.renamedFrom;
            html += `<div style="font-size:12px;color:#93c5fd;background:rgba(59,130,246,.1);
                        border:1px solid rgba(59,130,246,.35);border-radius:8px;padding:8px 14px;margin-bottom:16px;
                        display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
                <span>ⓘ SN này đã tiếp nhận dữ liệu sản xuất từ SN cũ <strong>${rf.oldSerial}</strong> (lý do: ${rf.reason || '—'}, lúc: ${fmtDate(rf.editedAt)}).</span>
                <button class="btn btn-gray" style="font-size:11px;padding:4px 12px;" onclick="searchSerial('${rf.oldSerial}')">Xem SN cũ →</button>
            </div>`;
        }
        html += buildJourney(data);
        html += buildCards(data);
        document.getElementById('result-area').innerHTML = html;
    }

    function backToSearch() {
        document.getElementById('result-area').innerHTML = '';
    }

    function searchSerial(s) {
        document.getElementById('inp-q').value = s;
        doSearch();
    }
</script>
