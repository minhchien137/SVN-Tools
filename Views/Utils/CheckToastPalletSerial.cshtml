<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kiểm tra Serial Scanner</title>

    <style>
            body {
                font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                margin: 0;
                min-height: 100vh;
                background: radial-gradient(circle at top, #1f2933, #0b0f14 60%);
                color: #e5e7eb;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            h1 {
                text-align: center;
                font-size: 34px;
                margin-bottom: 28px;
            }

            h2 {
                margin: 0 0 16px;
                font-size: 22px;
            }

            .wrapper {
                width: 1300px;
                max-width: 96vw;
            }

            .top {
                display: grid;
                grid-template-columns: 1.2fr 1fr;
                gap: 28px;
            }

            .card {
                background: linear-gradient(180deg, #111827, #0b1220);
                border-radius: 18px;
                padding: 26px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, .35);
            }

            label {
                font-size: 22px;
                font-weight: 600;
                display: block;
                margin-bottom: 14px;
            }

            input {
                width: 100%;
                font-size: 22px;
                padding: 16px 18px;
                border-radius: 14px;
                border: 3px solid #2563eb;
                outline: none;
                box-sizing: border-box;
            }

            .hint {
                margin-top: 14px;
                font-size: 15px;
                color: #9ca3af;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 16px;
            }

            th,
            td {
                padding: 12px 14px;
                border-bottom: 1px solid #374151;
                text-align: left;
            }

            th {
                background: #0f172a;
                font-weight: 600;
            }

            .pass {
                color: #22c55e;
                font-weight: 700;
            }

            .fail {
                color: #ef4444;
                font-weight: 700;
            }

            .detail {
                font-size: 13px;
                color: #9ca3af;
                margin-top: 4px;
                word-break: break-all;
            }

            .actions {
                margin-top: 18px;
                display: flex;
                gap: 12px;
            }

            button {
                padding: 10px 18px;
                font-size: 15px;
                border-radius: 10px;
                border: none;
                cursor: pointer;
                font-weight: 600;
            }

            #btnSave {
                background: #22c55e;
                color: #022c22;
            }

            #btnSave:disabled {
                background: #374151;
                color: #9ca3af;
                cursor: not-allowed;
            }

            #btnClear {
                background: #ef4444;
                color: white;
            }

            /* ===== BOTTOM TABLES ===== */
            .bottom {
                margin-top: 28px;
                display: grid;
                grid-template-columns: 1.3fr 1fr;
                gap: 28px;
            }

            /* SERIAL CELL – chống overflow */
            .serial-cell {
                max-width: 260px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                font-family: monospace;
            }

            @* .serial-cell:hover {
            white-space: normal;
            word-break: break-all;
        } *@

            .btn-x {
                background: #ef4444;
                color: white;
                padding: 4px 10px;
                border-radius: 6px;
                cursor: pointer;
                font-size: 14px;
            }

            #btnExport {
                background: #2563eb;
                color: white;
                font-size: 14px;
                padding: 8px 14px;
                border-radius: 8px;
            }
    </style>
</head>

<body>
    <div class="wrapper">
        <h1>Kiểm tra Serial Scanner</h1>

        <!-- TOP -->
        <div class="top">
            <div class="card">
                <label>Quét chuỗi serial</label>
                <input id="serialInput" autocomplete="off" />
                <div class="hint">
                    • Tối đa 50 serial, mỗi serial 13 ký tự, cách nhau bằng dấu phẩy<br>
                    • Chỉ cho phép A–Z, 0–9
                </div>

                <div class="actions">
                    <button id="btnSave" disabled>Lưu</button>
                    <button id="btnClear">Xóa tất cả</button>
                </div>
            </div>

            <div class="card">
                <table>
                    <thead>
                        <tr>
                            <th>Quy tắc</th>
                            <th>Kết quả</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Tổng số serial ≤ 50</td>
                            <td id="countResult"></td>
                        </tr>
                        <tr>
                            <td>Độ dài = 13</td>
                            <td id="lengthResult"></td>
                        </tr>
                        <tr>
                            <td>Ký tự cuối hợp lệ</td>
                            <td id="endCharResult"></td>
                        </tr>
                        <tr>
                            <td>Không trùng</td>
                            <td id="duplicateResult"></td>
                        </tr>
                        <tr>
                            <td>Serial không chứa ký tự đặc biệt</td>
                            <td id="charResult"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- BOTTOM -->
        <div class="bottom">
            <div class="card">
                <h2>Danh sách serial đã quét</h2>
                <table id="serialTable">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Serial</th>
                            <th>Dài</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="card">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <h2>Serial đã lưu</h2>
                    <button id="btnExport">Xuất Excel</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Chuỗi</th>
                            <th width="60">Xóa</th>
                        </tr>
                    </thead>
                    <tbody id="resultTable"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
            const input = document.getElementById("serialInput");
            const btnSave = document.getElementById("btnSave");
            let currentValidSerial = "";

            input.addEventListener("keydown", e => {
                if (e.key === "Enter") {
                    e.preventDefault();
                    validate();
                }
            });

            function getResult() {
                return JSON.parse(localStorage.getItem("Result") || "[]");
            }

            function setResult(arr) {
                localStorage.setItem("Result", JSON.stringify(arr));
            }

            function validate() {
                const rawInput = input.value;
                const raw = rawInput.trim();
                const serials = raw.split(",").filter(Boolean);

                const endsWithInvalidChar =
                    /\s$/.test(rawInput) || /[^A-Z0-9]$/i.test(rawInput);
                const invalidLength = serials.filter(s => s.length !== 13);

                const map = {};
                const duplicates = [];
                serials.forEach(s => map[s] = (map[s] || 0) + 1);
                Object.keys(map).forEach(s => map[s] > 1 && duplicates.push(s));

                const passCount = serials.length >= 1 && serials.length <= 50;
                const passLength = invalidLength.length === 0;
                const passEnd = !endsWithInvalidChar;
                const passDuplicate = duplicates.length === 0;
                const invalidCharSerials = serials.filter(
                    s => /[^A-Z0-9]/i.test(s)
                );
                const passChar = invalidCharSerials.length === 0;

                countResult.innerHTML = passCount ? `<span class="pass">PASS</span>` : `<span class="fail">FAIL</span>`;
                lengthResult.innerHTML = passLength ? `<span class="pass">PASS</span>` :
                    `<span class="fail">FAIL</span><div class="detail">${invalidLength.join(", ")}</div>`;
                endCharResult.innerHTML = passEnd ? `<span class="pass">PASS</span>` : `<span class="fail">FAIL</span>`;
                duplicateResult.innerHTML = passDuplicate ? `<span class="pass">PASS</span>` :
                    `<span class="fail">FAIL</span><div class="detail">${duplicates.join(", ")}</div>`;
                charResult.innerHTML =
                    passChar
                        ? `<span class="pass">PASS</span>`
                        : `<span class="fail">FAIL</span>
               <div class="detail">${invalidCharSerials.join(", ")}</div>`;

                const allPass = passCount && passLength && passChar && passEnd && passDuplicate;
                btnSave.disabled = !allPass;
                currentValidSerial = allPass ? raw : "";

                renderSerialTable(serials, map);
                input.select();
            }

            function renderSerialTable(serials, map) {
                const tbody = document.querySelector("#serialTable tbody");
                tbody.innerHTML = "";

                serials.forEach((s, i) => {
                    let status = "PASS", cls = "pass";
                    if (s.length !== 13 || /[^A-Z0-9]/i.test(s) || map[s] > 1) {
                        status = "FAIL";
                        cls = "fail";
                    }

                    tbody.innerHTML += `
                    <tr>
                        <td>${i + 1}</td>
                        <td class="serial-cell" title="${s}">${s}</td>
                        <td>${s.length}</td>
                        <td class="${cls}">${status}</td>
                    </tr>`;
                });
            }

            btnSave.onclick = () => {
                const arr = getResult();
                if (!arr.includes(currentValidSerial)) {
                    arr.push(currentValidSerial);
                    setResult(arr);
                }
                renderTable();
                input.value = "";
                input.focus();
                btnSave.disabled = true;
            };

            btnClear.onclick = () => {
                if (!confirm("Xóa toàn bộ dữ liệu đã lưu?")) return;
                setResult([]);
                renderTable();
            };

            function renderTable() {
                const tbody = document.getElementById("resultTable");
                tbody.innerHTML = "";
                getResult().forEach((item, i) => {
                    tbody.innerHTML += `
                    <tr>
                        <td class="serial-cell" title="${item}">${item}</td>
                        <td><button class="btn-x" onclick="removeItem(${i})">X</button></td>
                    </tr>`;
                });
            }

            function removeItem(i) {
                const arr = getResult();
                arr.splice(i, 1);
                setResult(arr);
                renderTable();
            }

            document.getElementById("btnExport").onclick = exportExcel;

            function exportExcel() {
                const data = getResult();

                if (data.length === 0) {
                    alert("Không có dữ liệu để xuất");
                    return;
                }

                // bọc mỗi chuỗi trong dấu "
                const csvContent = data
                    .map(s => `"${s.replace(/"/g, '""')}"`)
                    .join("\n");

                const blob = new Blob([csvContent], {
                    type: "text/csv;charset=utf-8;"
                });

                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");

                const now = new Date();
                const fileName =
                    "Serial_" +
                    now.getFullYear() +
                    (now.getMonth() + 1).toString().padStart(2, "0") +
                    now.getDate().toString().padStart(2, "0") +
                    "_" +
                    now.getHours().toString().padStart(2, "0") +
                    now.getMinutes().toString().padStart(2, "0") +
                    ".csv";

                a.href = url;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();

                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }


            document.addEventListener("DOMContentLoaded", renderTable);
    </script>
</body>

</html>