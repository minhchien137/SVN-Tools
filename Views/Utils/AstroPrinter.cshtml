<!-- Modal Quản lý Pallet -->
<div class="modal fade" id="manageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Quản lý Pallet <small class="text-muted" id="modalPalletId"></small>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div id="manageAlert" class="alert alert-warning d-none"></div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle" id="manageTable">
                        <thead class="table-light">
                            <tr>
                                <th class="id-col">#</th>
                                <th>Serial</th>
                                <th>Package ID</th>
                                <th class="action-col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- rows được render bằng JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', async function () {


        let zplTemplate;
        let previewBtn = document.getElementById('preview');
        let printBtn = document.getElementById('print');
        const packageIdInput = document.getElementById('packageId');
        let serialString = "";
        let today = new Date();
        let year = today.getFullYear();
        let month = (today.getMonth() + 1).toString().padStart(2, '0');
        let day = today.getDate().toString().padStart(2, '0');
        const prefix = `${year}${month}${day}`;
        const inputContainer = document.querySelector('.inputContainer');
        const quantity = document.getElementById('quantity');
        const addBtn = document.getElementById('quantityBtn');
        const checkBtn = document.getElementById("checkPackageId");
        const savePalletIdBtn = document.getElementById("savePalletId");
        const removePackageIdBtn = document.getElementById("packageIdRemoveBtn");


        @* PalletId *@

        const getPalletIDfromLS = () => {
            const plID = localStorage.getItem("palletIDAstro");
            if (plID) {
                document.getElementById("palletId").value = plID;
            }
            const astroDate = localStorage.getItem("astroDate");
            if (astroDate) {
                document.getElementById("dateCode").value = astroDate;
            }
        }
        getPalletIDfromLS();

        savePalletIdBtn.addEventListener("click", () => {
            const plID = document.getElementById("palletId").value;
            const astroDate = document.getElementById('dateCode').value;
            localStorage.setItem("palletIDAstro", plID);
            localStorage.setItem("astroDate", astroDate);
        })

        @* Tạo mã zpl *@

        const fetchImage = async (size, width, height, packageId, dateCode, desc, quantity, serialNumber1, serialNumber2, serialNumber3, serialNumber4, serialNumber5, serialNumber6, serialNumber7, serialNumber8, serialNumber9, serialNumber10, serialNumber11, serialNumber12, netWeight, grossWeight) => {
            const url = '@Url.Action("CreateLabelNoPreview", "Utils")';

            @* const image = $("#labelImage")[0]; *@

            const _ = window.location.pathname.split("/");
            const id = _[_.length - 1];


            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ size, width, height, id, packageId, dateCode, desc, quantity, serialNumber1, serialNumber2, serialNumber3, serialNumber4, serialNumber5, serialNumber6, serialNumber7, serialNumber8, serialNumber9, serialNumber10, serialNumber11, serialNumber12, netWeight, grossWeight })
            });

            if (res.ok) {
                const result = await res.json();
                @* image.setAttribute("src", result.imagePath); *@
                    zplTemplate = result.template;
            }

            return zplTemplate;
        }

        @* In *@

        const createLabelData = async (payload) => {
            const url = "/api/astrolabel";
            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            console.log(await res.json());
        }

        const printLabel = async () => {
            const size = document.getElementById('sizeLabel')?.value || "";
            const width = document.getElementById('widthLabel')?.value || "";
            const height = document.getElementById('heightLabel')?.value || "";
            const packageId = document.getElementById('packageId')?.value || "";
            const dateCode = document.getElementById('dateCode')?.value || "";
            const desc = document.getElementById('desc')?.value || "";
            const quantity = document.getElementById('quantity')?.value || "";
            const serialNumber1 = document.getElementById('serial_number1')?.value || "";
            const serialNumber2 = document.getElementById('serial_number2')?.value || "";
            const serialNumber3 = document.getElementById('serial_number3')?.value || "";
            const serialNumber4 = document.getElementById('serial_number4')?.value || "";
            const serialNumber5 = document.getElementById('serial_number5')?.value || "";
            const serialNumber6 = document.getElementById('serial_number6')?.value || "";
            const serialNumber7 = document.getElementById('serial_number7')?.value || "";
            const serialNumber8 = document.getElementById('serial_number8')?.value || "";
            const serialNumber9 = document.getElementById('serial_number9')?.value || "";
            const serialNumber10 = document.getElementById('serial_number10')?.value || "";
            const serialNumber11 = document.getElementById('serial_number11')?.value || "";
            const serialNumber12 = document.getElementById('serial_number12')?.value || "";
            const netWeight = document.getElementById('netWeight')?.value || "";
            const grossWeight = document.getElementById('grossWeight')?.value || "";


            const zplTemplate = await fetchImage(size, width, height, packageId, dateCode, desc, quantity, serialNumber1, serialNumber2, serialNumber3, serialNumber4, serialNumber5, serialNumber6, serialNumber7, serialNumber8, serialNumber9, serialNumber10, serialNumber11, serialNumber12, netWeight, grossWeight);


            @* print *@
                const printer = @Html.Raw(Json.Serialize(Model));
            const copies = document.getElementById('copies').value;

            const payload = {
                PrinterIpAddress: printer.iP_Printer,
                Port: printer.port_Printer,
                ZplCode: zplTemplate,
                Copies: copies
            }

            const urlPrint = '@Url.Action("printzpl", "Print")';

            const res = await fetch(urlPrint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            const res_ = await res.text();
            if (res_) {
                @* if (true) { *@
                const payload = {
                    date: prefix,
                    PackageID: packageIdInput.value,
                    Serial: serialString,
                    ScanDate: new Date(Date.now()).toLocaleString(),
                    PalletID: document.getElementById("palletId").value,
                    CountSerial: quantity,
                    EmployeeID: "astro"

                }
                console.log(payload)

                createLabelData(payload);

                const serialInputs = document.querySelectorAll('.serialInput');
                serialInputs.forEach((item) => {
                    item.value = "";
                })
                packageIdInput.value = parseInt(packageIdInput.value) + 1;
                serialString = "";
                serialInputs[0].focus();
            }
        }

        @* printBtn.addEventListener("click", async () => {
            event.preventDefault();
            await printLabel();
        }) *@


            @* Số lượng Input *@

        const addInput = () => {
            const num = parseInt(quantity.value);
            inputContainer.innerHTML = ''; // Xóa các input hiện tại
            if (isNaN(num) || num <= 0) {
                alert('Vui lòng nhập một số nguyên dương!');
                return;
            }
            for (let i = 1; i <= num; i++) {
                // Tạo một thẻ div để bọc mỗi ô input (tùy chọn, để dễ quản lý bố cục)
                const inputWrapper = document.createElement('div');
                inputWrapper.className = "col-3 mt-2";

                const inputElement = document.createElement('input');
                inputElement.type = 'text'; // Loại input là text
                inputElement.id = `serial_number${i}`; // Gán class là số tăng dần từ 1
                inputElement.className = 'serialInput'; // Gán class để dễ dàng truy cập
                inputElement.placeholder = `Serial Number ${i}`; // Đặt placeholder
                inputElement.value = ''; // Đặt giá trị mặc định là rỗng

                inputWrapper.appendChild(inputElement);
                inputContainer.appendChild(inputWrapper);
            }

            const serialInputs = document.querySelectorAll('.serialInput');
            serialInputs[0].focus();
            let typingTimer; // Biến để lưu trữ timer
            const doneTypingInterval = 200; // Thời gian chờ (miligiây) sau khi không có thêm input nào để xác định rằng barcode đã được quét xong
            serialInputs.forEach((input, index) => {
                input.addEventListener('input', function () {
                    clearTimeout(typingTimer); // Xóa timer trước đó nếu có
                    typingTimer = setTimeout(async () => {
                        // Đây là nơi bạn kiểm tra xem dữ liệu đã được điền đủ chưa
                        // và chuyển focus.
                        // Với máy đọc barcode, nó sẽ nhập rất nhanh và dừng lại đột ngột.
                        // Sau doneTypingInterval ms không có thêm input nào, chúng ta giả định
                        // rằng chuỗi barcode đã được nhập hoàn chỉnh.

                        if (this.value.length > 0) { // Đảm bảo đã có dữ liệu được nhập
                            if (this.value.length !== 14 || !this.value.startsWith("SN:")) {
                                alert("Số serial không hợp lệ");
                                this.value = "";
                            } else {
                                if (serialString.includes(this.value)) {
                                    alert("Số serial đã có trong các serial ở đây");
                                    this.value = "";
                                    return;
                                }
                                const isExist = await checkSerialInDB(this.value);
                                if (isExist) {
                                    alert("Số serial đã từng in rồi");
                                    this.value = "";
                                    return;
                                }
                                serialString += this.value + ",";
                                console.log(serialString);
                                if (index < serialInputs.length - 1) {
                                    serialInputs[index + 1].focus();
                                } else {
                                    console.log('Đã nhập hết tất cả các serial.');
                                    await printLabel();
                                }

                            }
                        }
                    }, doneTypingInterval);
                });
            });
        }

        addInput();
        if (addBtn) {
            addBtn.addEventListener("click", addInput);
        }

        @* Update PackageID *@

        const checkSerialInDB = async (serial) => {
            const url = `/api/AstroLabel/checkserial/${prefix}/${serial}`;
            const res = await fetch(url);
            let check = await res.json();
            return check;
        }

        const generatePackageId = async () => {
            const url = `/api/AstroLabel/GetPackageByPrefix/${prefix}`;


            const res = await fetch(url);

            if (!res.ok) {
                packageIdInput.value = prefix + "00001"
            } else {
                const curValue = await res.json();
                packageIdInput.value = parseInt(curValue) + 1;
            }
        }
        generatePackageId();

        const generatePackageId2 = async () => {
            const prefix = packageIdInput.value;
            const url = `/api/AstroLabel/GetPackageByPrefix/${prefix}`;


            const res = await fetch(url);

            if (!res.ok) {
                alert("PackageID này là mới ")
            } else {
                const curValue = await res.json();
                packageIdInput.value = parseInt(curValue) + 1;
                alert("Đã cập nhật tới PackageID mới nhất");
            }
        }

        checkBtn.addEventListener("click", generatePackageId2);

        @* Xóa packageId *@

        const deletePackageId = async () => {
            const removePackageId = document.getElementById("packageIdRemove").value;
            const url = `/api/AstroLabel/${removePackageId}`;
            const res = await fetch(url, { method: "DELETE" })
            if (res.ok) {
                alert("Xóa thành công");
            } else {
                alert("Xóa thất bại")
            };
            document.getElementById("packageIdRemove").value = "";
        }

        removePackageIdBtn.addEventListener("click", deletePackageId);


        // Bấm “Quản lý”: fetch + render + mở modal

        const fetchPalletById = async (pid) => {
            const url = `/api/AstroLabel/getPallet/${encodeURIComponent(pid)}`;
            const res = await fetch(url, { method: 'GET' });
            if (!res.ok) {
                const txt = await res.text().catch(() => '');
                throw new Error(`Lỗi API (${res.status})${txt ? ' - ' + txt : ''}`);
            }
            // cố parse json; nếu fail log text
            try {
                return await res.json();
            } catch {
                const raw = await res.text();
                console.error('Response không phải JSON. Raw:', raw);
                throw new Error('API không trả về JSON hợp lệ');
            }
        };

        const manageBtn = document.getElementById("checkPalletID");
        const manageModalEl = document.getElementById('manageModal');
        const modalPalletIdEl = document.getElementById('modalPalletId');
        const manageTableBody = document.querySelector('#manageTable tbody');




        const hideModal = (el) => {
            el.classList.remove('show');
            el.style.display = 'none';
            const backdrop = document.querySelector('.modal-backdrop');
            backdrop?.remove();
            document.body.classList.remove('modal-open');
        };

        // Helpers mở/đóng modal thuần
        const showModal = (el) => {
            // hiển thị modal
            el.style.display = 'block';
            el.classList.add('show');
            // backdrop
            const backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            document.body.appendChild(backdrop);
            // khóa scroll body
            document.body.classList.add('modal-open');
        };

        const renderManageRows = (rows = []) => {
            manageTableBody.innerHTML = '';

            if (rows && !Array.isArray(rows)) {
                if (Array.isArray(rows.items)) rows = rows.items;
                else rows = [rows];
            }

            if (!Array.isArray(rows) || rows.length === 0) {
                manageAlert.textContent = 'Không có dữ liệu cho Pallet này.';
                manageAlert.classList.remove('d-none');
                return;
            }

            manageAlert.classList.add('d-none');

            rows.forEach((r, index) => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="id-col">${index + 1}</td>

                <td class="serial-cell">
                    ${r.serial ?? ''}
                </td>

                <td class="package-cell">
                    ${r.packageID ?? r.packageId ?? ''}
                </td>

                <td class="action-col">
                    <button class="btn btn-sm btn-danger btn-delete"
                            data-serial="${r.serial}">
                        Delete
                    </button>
                </td>
            `;
            manageTableBody.appendChild(tr);
});

        };

        const handleCheckPalletId = async () => {
            const palletId = document.getElementById("palletId").value;
            const url = `/api/AstroLabel/count/${palletId}`;
            const res = await fetch(url);
            let count = await res.json();
            countPallet = count;
            document.getElementById("countPallet").innerHTML = count;
            console.log(count);
            return count;
        }

        // Nút đóng góc phải
        manageModalEl.querySelector('.btn-close')?.addEventListener('click', () => hideModal(manageModalEl));
        // Click nền ngoài để đóng
        manageModalEl.addEventListener('click', (e) => {
            if (e.target === manageModalEl) hideModal(manageModalEl);
        });

        // Đóng modal khi bấm nút close / nút footer / click ra ngoài
        manageModalEl.querySelector('.btn-close')?.addEventListener('click', () => hideModal(manageModalEl));
        manageModalEl.querySelector('[data-bs-dismiss="modal"]')?.addEventListener('click', () => hideModal(manageModalEl));
        // click ra nền tối (khoảng ngoài content)
        manageModalEl.addEventListener('click', (e) => {
            if (e.target === manageModalEl) hideModal(manageModalEl);
        });


        manageBtn?.addEventListener('click', async () => {
            const pid = (document.getElementById('palletId')?.value || '').trim();
            modalPalletIdEl.textContent = pid ? `#${pid}` : '';

            // Reset trạng thái trong modal
            manageAlert.classList.add('d-none');
            manageTableBody.innerHTML = `<tr><td colspan="4">Đang tải dữ liệu...</td></tr>`;

            // Mở modal ngay (UX tốt hơn), dữ liệu load xong sẽ thay
            showModal(manageModalEl);

            if (!pid) {
                manageTableBody.innerHTML = '';
                manageAlert.textContent = 'Hãy nhập Pallet ID trước.';
                manageAlert.classList.remove('d-none');
                return;
            }

            try {
                const data = await fetchPalletById(pid);
                console.log('getPallet data:', data);
                renderManageRows(data);
            } catch (err) {
                console.error(err);
                manageTableBody.innerHTML = '';
                manageAlert.textContent = err?.message || 'Đã xảy ra lỗi khi tải dữ liệu.';
                manageAlert.classList.remove('d-none');
            }
        });

        manageTableBody.addEventListener('click', async (e) => {
            const btn = e.target.closest('.btn-delete');
            if (!btn) return;

            // Lấy serial gốc từ data-serial (giữ nguyên, có thể có dấu phẩy cuối)
            const serialRaw = btn.getAttribute('data-serial') || '';
            if (!serialRaw) {
                alert('Không tìm thấy serial để xóa.');
                return;
            }

            // Lấy pallet hiện tại để reload sau khi xóa
            const pid = (document.getElementById('palletId')?.value || '').trim();
            if (!pid) {
                alert('Thiếu Pallet ID để tải lại danh sách.');
                return;
            }

            // Trạng thái loading cho nút
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Deleting...';

            try {
                const url = `/api/AstroLabel/deleteInPallet/${encodeURIComponent(serialRaw)}`;

                // Nhiều backend map route này là GET (giống các API khác của bạn).
                // Nếu backend yêu cầu DELETE/POST thì đổi method tương ứng.
                const res = await fetch(url, { method: 'GET' });

                // API nói trả về duy nhất true/false -> parse linh hoạt
                let ok = false;
                try {
                    const ct = res.headers.get('content-type') || '';
                    if (ct.includes('application/json')) {
                        const j = await res.json();
                        ok = j === true;
                    } else {
                        const t = (await res.text()).trim().toLowerCase();
                        ok = (t === 'true');
                    }
                } catch {
                    ok = false;
                }

                if (!res.ok) {
                    throw new Error(`HTTP ${res.status}`);
                }

                if (ok) {
                    // Xóa xong: load lại bảng để dữ liệu chuẩn xác
                    manageAlert.classList.add('d-none');
                    manageTableBody.innerHTML = `<tr><td colspan="4">Đang tải dữ liệu...</td></tr>`;
                    const data = await fetchPalletById(pid);
                    renderManageRows(data);
                    await generatePackageId2();
                } else {
                    alert('Xóa không thành công (API trả về false).');
                    btn.disabled = false;
                    btn.textContent = originalText;
                }
            } catch (err) {
                console.error(err);
                alert('Có lỗi khi gọi API xóa.');
                btn.disabled = false;
                btn.textContent = originalText;
            }
        });
        document.addEventListener('copy', function (e) {
            const selection = window.getSelection();
            if (!selection || selection.isCollapsed) return;

            let rows = [];
            const table = document.getElementById('manageTable');
            if (!table || !table.contains(selection.anchorNode)) return;

            table.querySelectorAll('tbody tr').forEach(tr => {
                const serial = tr.querySelector('.serial-cell')?.innerText.trim();
                const packageId = tr.querySelector('.package-cell')?.innerText.trim();
                if (serial && packageId) {
                    rows.push(`${serial}\t${packageId}`);
                }
            });

            if (rows.length > 0) {
                e.preventDefault();
                e.clipboardData.setData('text/plain', rows.join('\n'));
            }
        });


    });


</script>