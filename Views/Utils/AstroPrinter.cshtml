@model SVN_Tools.Models.Utils.PrinterData;

@{
    ViewData["Title"] = ViewBag.oper;
}

<style>
    /* Modal full màn hình */
    #manageModal .modal-dialog {
        max-width: 100vw;
        width: 100vw;
        height: 100vh;
        margin: 0;
        padding: 0;
    }

    #manageModal .modal-content {
        height: 100vh;
        border-radius: 0;
        display: flex;
        flex-direction: column;
    }

    #manageModal .modal-body {
        flex: 1 1 auto;
        overflow-y: auto;
    }

    #manageModal .table-responsive {
        max-height: calc(100vh - 200px);
        /* giữ phần header/footer */
        overflow-y: auto;
    }

    /* Tùy chọn: làm header modal cố định khi cuộn */
    #manageModal .modal-header,
    #manageModal .modal-footer {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #fff;
    }

    #manageModal .modal-footer {
        bottom: 0;
        top: auto;
    }

    /* Mặc định: không cho bôi đen toàn bộ bảng */
    #manageTable td {
        user-select: none;
    }

    /* Riêng cột Serial thì cho phép */
    #manageTable td.serial-cell {
        user-select: text;
    }
    #manageTable {
    table-layout: fixed;
    width: 100%;
}

#manageTable th,
#manageTable td {
    vertical-align: top;
    font-size: 13px;
}

#manageTable td.serial-cell,
#manageTable td.package-cell {
    white-space: normal;
    word-break: break-word;
    line-height: 1.5;
}

/* Cột ID nhỏ lại */
#manageTable th.id-col,
#manageTable td.id-col {
    width: 60px;
    text-align: center;
}

/* Cột Action cố định */
#manageTable th.action-col,
#manageTable td.action-col {
    width: 90px;
    text-align: center;
}

/* Chỉ cho phép select ở 2 cột cần copy */
#manageTable td {
    user-select: none;
}

#manageTable td.serial-cell,
#manageTable td.package-cell {
    user-select: text;
    cursor: text;
}
</style>

