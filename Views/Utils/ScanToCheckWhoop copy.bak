            function updateTargetChip() { targetDisplay.innerHTML = `Mốc: <strong>${targetCount}</strong> chiếc (nhấn <kbd>Numpad 5</kbd> để đổi 36/80)`; }
            updateTargetChip();

            let count = 0;

