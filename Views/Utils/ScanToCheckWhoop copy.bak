    <script>
        (function () {
            const bin = document.getElementById('bin');
            const box = document.getElementById('box');
            const indicator = document.getElementById('indicator');
            const status = document.getElementById('status');
            const counterEl = document.getElementById('counter');
            const targetDisplay = document.getElementById('targetDisplay');

            // Mốc mặc định (dùng khi server lỗi / trả content không hợp lệ)
            let targetCount = 80;
            function updateTargetChip() {
                targetDisplay.innerHTML = `Mốc: <strong>${targetCount}</strong> chiếc`;
            }
            updateTargetChip();

            let count = 0;

            [bin, box].forEach(el => el.addEventListener('focus', () => el.select()));
            window.addEventListener('load', () => bin.focus());

            // =========================
            // BIN: debounce + gọi proxy
            // =========================
            let binDebounce;
            bin.addEventListener('input', () => {
                clearTimeout(binDebounce);
                if (bin.value.trim().length === 0) return;
                binDebounce = setTimeout(async () => {
                    const serial = normalize(bin.value);
                    status.textContent = 'Đang lấy thông tin thùng: ' + serial;
                    await fetchAndSetTargetFromProxy(serial);
                    status.textContent = 'Đang quét hộp cho thùng: ' + serial;
                    box.focus();
                }, 350);
            });

            bin.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    if (bin.value.trim().length === 0) return;
                    const serial = normalize(bin.value);
                    status.textContent = 'Đang lấy thông tin thùng: ' + serial;
                    fetchAndSetTargetFromProxy(serial).then(() => {
                        status.textContent = 'Đang quét hộp cho thùng: ' + serial;
                    });
                    box.focus();
                }
            });

            // Gọi proxy backend thay vì API gốc (tránh CORS)
            async function fetchAndSetTargetFromProxy(serial) {
                if (!serial) return;
                // Dùng đường dẫn tương đối để trúng đúng origin của app
                const apiUrl = '/api/verifyemployeedata/GetProductItemByCode?code=' + encodeURIComponent(serial);;

                try {
                    status.textContent = 'Lấy mốc từ server cho: ' + serial + ' ...';
                    const resp = await fetch(apiUrl, { method: 'GET' });

                    // Proxy trả nguyên status code của upstream; vẫn nên cố gắng parse JSON nếu có
                    let data = null;
                    const text = await resp.text();
                    try { data = text ? JSON.parse(text) : null; } catch { /* giữ data = null nếu parse lỗi */ }

                    if (!resp.ok) {
                        status.textContent = `Lỗi server (${resp.status}) khi lấy mốc cho ${serial}`;
                        return;
                    }

                    if (data && data.content !== undefined && data.content !== null) {
                        const parsed = parseInt(String(data.content).trim(), 10);
                        if (!Number.isNaN(parsed) && parsed > 0) {
                            targetCount = parsed;
                            updateTargetChip();
                            // Nếu đang vượt mốc mới, cảnh báo ngay
                            if (count >= targetCount) {
                                flash('warn');
                                alert('ĐÃ ĐỦ SỐ LƯỢNG ' + targetCount + ' - KHÔNG ĐƯỢC BỎ THÊM!');
                            }
                            status.textContent = 'Mốc đặt bởi server: ' + targetCount;
                        } else {
                            status.textContent = 'Server trả mốc không hợp lệ: ' + String(data?.content);
                        }
                    } else {
                        status.textContent = 'Server trả dữ liệu rỗng/không hợp lệ.';
                    }
                } catch (err) {
                    console.error('Proxy error:', err);
                    status.textContent = 'Lỗi khi gọi proxy — dùng mốc mặc định ' + targetCount;
                }
            }

            // =========================
            // BOX: giữ nguyên logic so khớp
            // =========================
            let boxDebounce;
            const processBox = () => {
                const binVal = normalize(bin.value);
                const boxVal = normalize(box.value);
                if (!boxVal) return;

                const ok = binVal && boxVal && binVal === boxVal;
                flash(ok ? 'ok' : 'bad');
                status.innerHTML = ok
                    ? '✔ Khớp: <strong>' + boxVal + '</strong>'
                    : '✖ KHÔNG khớp! Hộp: <strong>' + boxVal + '</strong> ≠ Thùng: <strong>' + binVal + '</strong>';

                if (ok) incrementCounter();

                box.value = '';
                box.focus();
            };

            box.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    processBox();
                }
            });
            box.addEventListener('input', () => {
                clearTimeout(boxDebounce);
                if (box.value.trim().length === 0) return;
                boxDebounce = setTimeout(processBox, 300);
            });

            // =========================
            // Hotkeys (đã bỏ Numpad5)
            // =========================
            window.addEventListener('keydown', (e) => {
                if (e.code === 'Numpad1') {
                    e.preventDefault();
                    resetAll();
                } else if (e.code === 'Numpad2') {
                    e.preventDefault();
                    resetCounter();
                } else if (e.code === 'Numpad3') {
                    e.preventDefault();
                    window.location.href = 'http://10.10.99.10:8100/tools/workorderinfo';
                } else if (e.code === 'Numpad4') {
                    e.preventDefault();
                    window.location.href = 'http://10.10.99.10:8102/Utils/Whoop/WHOOP';
                }
            }, { capture: true });

            // =========================
            // Counter / helpers / UX
            // =========================
            function resetAll() {
                bin.value = '';
                box.value = '';
                resetCounter();
                status.textContent = 'Đã reset. Quét serial thùng mới.';
                indicator.classList.remove('flash-ok', 'flash-bad', 'flash-warn');
                bin.focus();
            }

            function resetCounter() {
                count = 0;
                counterEl.textContent = `${String(count)}/${String(targetCount)}`;
            }

            function incrementCounter() {
                if (count >= targetCount) {
                    flash('warn');
                    alert('ĐÃ ĐỦ SỐ LƯỢNG ' + targetCount + ' - KHÔNG ĐƯỢC BỎ THÊM!');
                    resetCounter();
                    return;
                }
                count += 1;
                counterEl.textContent = `${String(count)}/${String(targetCount)}`;
            }

            function normalize(s) {
                return (s || '').trim().replace(/\s+/g, '').toUpperCase();
            }

            let flashTimer;
            function flash(type) {
                clearTimeout(flashTimer);
                indicator.classList.remove('flash-ok', 'flash-bad', 'flash-warn');
                indicator.classList.add(type === 'ok' ? 'flash-ok' : (type === 'warn' ? 'flash-warn' : 'flash-bad'));
                flashTimer = setTimeout(() => {
                    indicator.classList.remove('flash-ok', 'flash-bad', 'flash-warn');
                }, 500);
            }

            document.addEventListener('mousedown', (e) => { e.preventDefault(); }, { capture: true });
            document.addEventListener('contextmenu', (e) => { e.preventDefault(); });
        })();
    </script>
</body>

</html>