<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon.png">
    <title>@ViewData["Title"] - SVN_Portal</title>
    <link href="~/lib/amchart/export.css" rel="stylesheet" />
    <!-- Bootstrap Core CSS -->
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/SVN_Portal.styles.css" asp-append-version="true" /> *@
    <!-- Custom CSS -->
    <link href="~/css/helper.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
    <!-- All Jquery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap tether Core JavaScript -->
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <!-- slimscrollbar scrollbar JavaScript -->
    <script src="~/js/jquery.slimscroll.js"></script>
    <!--Menu sidebar -->
    <script src="~/js/sidebarmenu.js"></script>
    <!--stickey kit -->
    <script src="~/lib/sticky-kit-master/dist/sticky-kit.min.js"></script>
    <!-- Amchart -->
    <script src="~/lib/chart-amchart/amcharts.js"></script>
    <script src="~/lib/chart-amchart/serial.js"></script>
    <script src="~/lib/chart-amchart/export.min.js"></script>
    <script src="~/lib/chart-amchart/light.js"></script>
    <script src="~/lib/chart-amchart/ammap.js"></script>
    <script src="~/lib/chart-amchart/worldlow.js"></script>
    <script src="~/lib/chart-amchart/pie.js"></script>
    <script src="~/lib/chart-amchart/amstock.js"></script>
    <script src="~/lib/chart-amchart/amchart-init.js"></script>
    @* <script>
        var timeBeforeReload = @appConfig.TimeBeforeReload;
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script> *@
    <!--Custom JavaScript -->
    <script src="~/js/scripts.js"></script>
</head>

<body>
    <!-- Preloader - style you can find in spinners.css -->
    <div class="preloader">
        <svg class="circular" viewBox="25 25 50 50">
            <circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="2" stroke-miterlimit="10" />
        </svg>
    </div>
    <!-- Main wrapper  -->
    <div id="main-wrapper">
        <div class="header">
            <nav class="navbar top-navbar navbar-expand-md navbar-light">
                <!-- Logo -->
                <div class="navbar-header">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <!-- Logo icon -->
                        <b><img src="~/images/logo.png" alt="homepage" class="dark-logo" /></b>
                        <!--End Logo icon -->
                        <!-- Logo text -->
                        <span><img src="~/images/logo-text.png" alt="homepage" class="dark-logo" /></span>
                    </a>
                </div>
                <!-- End Logo -->
                <div class="navbar-collapse">
                    <!-- toggle and nav items -->
                    <ul class="navbar-nav mr-auto mt-md-0">
                        <!-- This is  -->
                        <li class="nav-item"> <a class="nav-link nav-toggler hidden-md-up text-muted  "
                                href="javascript:void(0)"><i class="mdi mdi-menu"></i></a> </li>
                        <li class="nav-item m-l-10"> <a class="nav-link sidebartoggler hidden-sm-down text-muted  "
                                href="javascript:void(0)"><i class="ti-menu"></i></a> </li>
                        <!-- Search -->

                    </ul>
                    <!-- User profile and search -->
                    <ul class="navbar-nav my-lg-0">
                        <!-- Comment -->

                    </ul>
                </div>
                <span id="datetime" style="font-size: 72px; color: #007bff; font-weight: 700;"></span>
            </nav>
        </div>
        <!-- End header header -->
        <!-- Left Sidebar  -->
        @{
            List<string> operList = appConfig.OperList.Split(",").ToList();
        }
        <div class="left-sidebar">
            <!-- Sidebar scroll-->
            <div class="scroll-sidebar">
                <!-- Sidebar navigation-->
                <nav class="sidebar-nav mt-5">
                    <ul id="sidebarnav">
                        <li class="nav-devider"></li>
                        <li class="nav-label"></li>
                        <li>
                            <a class="has-arrow  " href="#" aria-expanded="false"><i class="fa fa-cogs"></i><span
                                    class="hide-menu">Tools <span
                                        class="label label-rouded label-primary pull-right">6</span></span></a>
                            <ul aria-expanded="false" class="collapse">
                                <li><a asp-controller="Home" asp-action="PrinterManager">Quản lý máy in</a></li>
                                <li><a asp-controller="Home" asp-action="PrintTem">In tem</a></li>
                                <li><a asp-controller="Home" asp-action="PrintShippingLabelBySeriNumber">In Shipping
                                        Label</a></li>
                                <li><a asp-controller="Home" asp-action="PrintAstroLabel">Print Astro Label</a></li>
                                <li><a asp-controller="Home" asp-action="PrintToastLabel">Print Toast Label</a></li>
                                <li><a asp-controller="Home" asp-action="ProductionUpdateQty">Update số lượng</a></li>
                                <li><a asp-controller="Home" asp-action="ProductInfo">Product Info</a></li>
                                <li><a asp-controller="Utils" asp-action="UltimatePrint">Ultimate Print</a></li>
                                <li><a asp-controller="Utils" asp-action="ToastLookup">Toast Lookup</a></li>
                            </ul>
                        </li>
                        <li>
                            <!-- <a class="has-arrow  " href="#" aria-expanded="false"><i class="fa fa-globe"></i><span
                                    class="hide-menu">Live </span></a> -->
                            <ul aria-expanded="false" class="collapse">
                                <li><a href="http://10.10.99.10:8102/Utils/Astro/TEST_ASTRO" target="_blank">Astro Test</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/ToastOneSerial/TEST_TOAST_1SERIAL" target="_blank">Toast One Serial Test</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/toast/TEST_TOAST" target="_blank">Toast Test</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/wh/TEST_WH" target="_blank">WH Label Test</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/whoop/TEST_WHOOP" target="_blank">Whoop Test</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/whoopnew/TEST_WHOOPNEW" target="_blank">Whoop New Test</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/walterinbox/TEST_WALTERINBOX" target="_blank">Walter In Box Test</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/scantocheck/whoop" target="_blank">Scan To Check Whoop</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/scantocheckwithwo/whoop" target="_blank">Scan To Check Whoop WO</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/fctscan/toast" target="_blank">FCT Scan Toast</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/CheckToastPalletSerial" target="_blank">Check Toast Pallet</a></li>
                                <li><a href="http://10.10.99.10:8102/Utils/GetInfoSerial" target="_blank">Get Info Serial</a></li>
                            </ul>
                        </li>
                    </ul>
                </nav>
                <!-- End Sidebar navigation -->
            </div>
            <!-- End Sidebar scroll-->
        </div>
        <!-- End Left Sidebar  -->
        <!-- Page wrapper  -->
        <div class="page-wrapper svn-layout">
            <!-- Bread crumb -->
            <div class="row page-titles">
                <div class="col-md-5 align-self-center">
                    <h5 class="text-primary">
                        @ViewBag.oper
                    </h5>

                </div>
                <div class="col-md-7 align-self-center">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">home</a></li>
                        <li class="breadcrumb-item active">Tools</li>
                        @{
                            string destinationlink = ViewBag.oper;
                        }
                        @if (!string.IsNullOrWhiteSpace(destinationlink))
                        {
                            <li class="breadcrumb-item active">@destinationlink</li>
                        }
                    </ol>
                </div>
            </div>
            <!-- End Bread crumb -->
            <!-- Container fluid  -->
            <div class="container-fluid">
                @RenderBody()
            </div>
            <!-- End Container fluid  -->
            <!-- footer -->

            <!-- End footer -->
        </div>
        <!-- End Page wrapper  -->
    </div>
    <!-- End Wrapper -->
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>